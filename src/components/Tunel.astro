---
/**
 * Del túnel de vestuarios al campo, con dos imágenes: al hacer scroll, zoom hacia la luz del fondo
 * del túnel y fundido con el campo. El rótulo (título, ciudad, fechas) está a la vista desde el
 * principio y crece al llegar al campo.
 *
 * Solo se anima si el dispositivo puede (sin «Reducir movimiento», sin ahorro de datos ni red lenta,
 * con memoria y núcleos de sobra). Si no, o sin JavaScript, se ve el campo quieto con el rótulo y la
 * imagen del túnel ni se descarga. El scroll es el del navegador: no se toca.
 *
 * Imágenes en src/fotos/tunel/: horizontal (16:9) y vertical (9:16, la de las pantallas en vertical).
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

import campo from '../fotos/tunel/campo.jpg';
import campoMovil from '../fotos/tunel/campo-movil.jpg';
import tunel from '../fotos/tunel/tunel.jpg';
import tunelMovil from '../fotos/tunel/tunel-movil.jpg';

interface Props {
  titulo: string;
  /** Línea bajo el título, p. ej. «Torrent · 5, 6 y 7 de diciembre de 2026 · 60 equipos» */
  linea: string;
}
const { titulo, linea } = Astro.props;

const CREDITO = 'Imagen generada con IA';
const VERTICAL = '(orientation: portrait)';

/** srcset por formato para unos anchos, sin pasar del ancho del original */
async function srcset(img: ImageMetadata, anchos: number[], format: 'avif' | 'webp') {
  const validos = [...new Set(anchos.map((a) => Math.min(a, img.width)))];
  const hechas = await Promise.all(validos.map((width) => getImage({ src: img, width, format, quality: format === 'avif' ? 50 : 70 })));
  return hechas.map((h, i) => `${h.src} ${validos[i]}w`).join(', ');
}

async function fuentes(horizontal: ImageMetadata, vertical: ImageMetadata) {
  const H = [960, 1280, 1920];
  const V = [400, 600, 900];
  return {
    vertical: { avif: await srcset(vertical, V, 'avif'), webp: await srcset(vertical, V, 'webp') },
    horizontal: { avif: await srcset(horizontal, H, 'avif'), webp: await srcset(horizontal, H, 'webp') },
    jpg: (await getImage({ src: horizontal, width: Math.min(1280, horizontal.width), format: 'jpg', quality: 72 })).src,
    ancho: horizontal.width,
    alto: horizontal.height,
  };
}

const capas = [
  { clase: 'tunel__capa--tunel', ...(await fuentes(tunel, tunelMovil)), prioridad: true },
  { clase: 'tunel__capa--campo', ...(await fuentes(campo, campoMovil)), prioridad: false },
];
---
<script is:inline>
  // Antes de pintar: ¿se anima? Así la sección tiene su altura desde el principio
  (function () {
    var n = navigator, c = n.connection, ok = matchMedia('(prefers-reduced-motion: no-preference)').matches;
    if (c && (c.saveData || /2g|3g/.test(c.effectiveType || ''))) ok = false;
    if (n.deviceMemory && n.deviceMemory < 4) ok = false;
    if (n.hardwareConcurrency && n.hardwareConcurrency < 4) ok = false;
    if (ok) document.documentElement.dataset.tunel = 'animado';
  })();
</script>

<section class="tunel" data-capitulo="marino" aria-labelledby="tunel-titulo">
  <div class="tunel__escenario">
    {capas.map((c) => (
      <picture class:list={['tunel__capa', c.clase]}>
        <source media={VERTICAL} type="image/avif" srcset={c.vertical.avif} sizes="100vw" />
        <source media={VERTICAL} type="image/webp" srcset={c.vertical.webp} sizes="100vw" />
        <source type="image/avif" srcset={c.horizontal.avif} sizes="100vw" />
        <source type="image/webp" srcset={c.horizontal.webp} sizes="100vw" />
        <img src={c.jpg} alt="" width={c.ancho} height={c.alto} loading="lazy" decoding="async" fetchpriority={c.prioridad ? 'high' : undefined} />
      </picture>
    ))}
    <div class="tunel__luz" aria-hidden="true"></div>
    <div class="tunel__rotulo">
      <h1 id="tunel-titulo" class="tunel__titulo">{titulo}</h1>
      <p class="tunel__linea">{linea}</p>
    </div>
    <p class="tunel__credito">{CREDITO}</p>
  </div>
</section>

<style>
  .tunel { position: relative; }
  .tunel__escenario {
    position: relative;
    height: calc(100svh - var(--cabecera));
    min-height: 420px;
    overflow: hidden;
    background: var(--marino);
  }
  .tunel__capa,
  .tunel__capa img,
  .tunel__luz {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* La luz del fondo del túnel está al 50 % · 44 % de la imagen: el recorte y el zoom se anclan ahí */
  .tunel__capa img { object-fit: cover; object-position: 50% 44%; }
  .tunel__capa { transform-origin: 50% 44%; }

  .tunel__luz {
    background: radial-gradient(ellipse 40% 35% at 50% 44%, #fff3c4, transparent 70%);
    opacity: 0;
    pointer-events: none;
  }

  .tunel__rotulo {
    position: absolute;
    left: var(--margen);
    bottom: var(--margen);
    max-width: calc(100% - 2 * var(--margen));
    padding: 20px 24px 22px;
    background: var(--marino);
    color: var(--blanco);
    transform-origin: 0 100%;
  }
  .tunel__titulo {
    font-size: clamp(3.5rem, 1rem + 9vw, 10rem);
    line-height: 0.85;
    text-transform: uppercase;
  }
  .tunel__linea {
    margin-top: 12px;
    font-size: var(--step-lead);
    line-height: 1.2;
    color: var(--amarillo);
  }
  .tunel__credito {
    position: absolute;
    right: var(--margen);
    top: var(--margen);
    padding: 4px 8px;
    background: var(--marino);
    color: var(--blanco);
    font-size: var(--step-small);
    line-height: 1.3;
  }

  /* Quieto: solo el campo; el túnel no se pinta y, como es lazy, no se descarga */
  :global(html:not([data-tunel='animado'])) .tunel__capa--tunel { display: none; }

  /* Animado: la sección se alarga y el escenario se queda fijo mientras se recorre */
  :global(html[data-tunel='animado']) .tunel { height: 260svh; }
  :global(html[data-tunel='animado']) .tunel__escenario { position: sticky; top: var(--cabecera); }
  :global(html[data-tunel='animado']) .tunel__capa,
  :global(html[data-tunel='animado']) .tunel__rotulo { will-change: transform; }
  /* El campo espera a que la página haya cargado (lo quita el script) */
  :global(html[data-tunel='animado']) .tunel__capa--campo { opacity: 0; will-change: transform, opacity; }
  :global(html[data-tunel='animado']) .tunel__capa--campo:not(.cargado) { display: none; }
  :global(html[data-tunel='animado']) .tunel__rotulo { transform: scale(0.7); }

  @media (max-width: 599px) {
    .tunel__rotulo { padding: 16px 18px 18px; }
  }
</style>

<script>
  const raiz = document.documentElement;
  const seccion = document.querySelector<HTMLElement>('.tunel')!;
  const escenario = seccion.querySelector<HTMLElement>('.tunel__escenario')!;
  const tunel = seccion.querySelector<HTMLElement>('.tunel__capa--tunel')!;
  const campo = seccion.querySelector<HTMLElement>('.tunel__capa--campo')!;
  const luz = seccion.querySelector<HTMLElement>('.tunel__luz')!;
  const rotulo = seccion.querySelector<HTMLElement>('.tunel__rotulo')!;

  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const tramo = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
  const suave = (t: number) => t * t * (3 - 2 * t);
  const acelera = (t: number) => t * t;
  const frena = (t: number) => 1 - (1 - t) * (1 - t);

  function pintar() {
    pendiente = false;
    const r = seccion.getBoundingClientRect();
    const p = clamp(-r.top / (r.height - escenario.clientHeight));
    // Avance hacia la luz, cada vez más rápido
    tunel.style.transform = `scale(${1 + 2.4 * acelera(tramo(p, 0, 0.7))})`;
    // Destello al llegar a la boca
    luz.style.opacity = String(0.55 * (suave(tramo(p, 0.3, 0.55)) - suave(tramo(p, 0.55, 0.8))));
    // El campo entra cerrado (como se ve desde la boca) y se abre al salir; el fundido, corto y en el destello
    campo.style.opacity = String(suave(tramo(p, 0.47, 0.62)));
    campo.style.transform = `scale(${1.6 - 0.6 * frena(tramo(p, 0.42, 1))})`;
    rotulo.style.transform = `scale(${0.7 + 0.3 * suave(tramo(p, 0.6, 0.9))})`;
  }

  let pendiente = false;
  const pedir = () => {
    if (pendiente) return;
    pendiente = true;
    requestAnimationFrame(pintar);
  };

  /** Vuelve a la versión quieta */
  function quieto() {
    removeEventListener('scroll', pedir);
    removeEventListener('resize', pedir);
    delete raiz.dataset.tunel;
    for (const el of [tunel, campo, luz, rotulo]) el.removeAttribute('style');
    campo.classList.add('cargado');
  }

  if (raiz.dataset.tunel === 'animado') {
    // El campo, después de la carga: no compite con la imagen del túnel, que es la primera que se ve
    const traerCampo = () => campo.classList.add('cargado');
    document.readyState === 'complete' ? traerCampo() : addEventListener('load', traerCampo, { once: true });
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir);
    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (e) => e.matches && quieto(), { once: true });
    pintar();
  }
</script>
