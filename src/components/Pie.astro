---
/**
 * Pie compacto, igual en todas las páginas: logo, contacto, Instagram de cada marca, enlaces
 * legales, la entidad titular (lo que pide Apple) y los créditos de las fotos.
 */
import { academy, cup, entidad } from '../data/contenido';
import { creditos } from '../lib/fotos';
import { ruta } from '../lib/ruta';
import { t, type Idioma } from '../i18n/ui';
import Dato from './Dato.astro';
import Monograma from './Monograma.astro';
import SiCompleto from './SiCompleto.astro';

interface Props { idioma?: Idioma; /** Huecos de foto que usa la página, para sus créditos */ fotos?: string[] }
const { idioma = 'es', fotos = [] } = Astro.props;
const fotografos = creditos(fotos);
---
<footer class="pie" data-capitulo="marino">
  <div class="pie__marca">
    <Monograma class="pie__xb" />
    <p>{academy.nombre}</p>
  </div>

  <div class="pie__col pie__col--contacto">
    <h2>{t(idioma, 'pie.contacto')}</h2>
    <p><a href={`mailto:${entidad.email}`}>{entidad.email}</a></p>
  </div>

  <div class="pie__col pie__col--instagram">
    <h2>{t(idioma, 'pie.instagram')}</h2>
    <ul role="list">
      <li>{academy.nombre}: <a href={`https://www.instagram.com/${academy.instagram}/`} rel="noopener">@{academy.instagram}</a></li>
      <li>{cup.nombre}: <a href={`https://www.instagram.com/${cup.instagram}/`} rel="noopener">@{cup.instagram}</a></li>
    </ul>
  </div>

  <div class="pie__col pie__col--legal">
    <h2>{t(idioma, 'pie.legal')}</h2>
    <ul role="list">
      <li><a href={ruta('/aviso-legal/')}>{t(idioma, 'pie.avisoLegal')}</a></li>
      <li><a href={ruta('/privacidad/')}>{t(idioma, 'pie.privacidad')}</a></li>
      <li><a href={ruta('/soporte/')}>{t(idioma, 'pie.soporte')}</a></li>
    </ul>
  </div>

  <div class="pie__base">
    <address>
      {entidad.nombre} · NIF {entidad.nif} · {entidad.direccion}, {entidad.ciudad}
      <SiCompleto datos={[entidad.registro]} donde="pie: registro de asociaciones">
        · <Dato v={entidad.registro} donde="pie: registro de asociaciones" />
      </SiCompleto>
    </address>
    {fotografos.length > 0 && <p>{t(idioma, 'pie.fotos')}: {fotografos.join('; ')}.</p>}
  </div>
</footer>

<style>
  .pie {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr 1fr;
    gap: 32px;
    padding: 48px var(--margen) 28px;
    font-size: var(--step-small);
    line-height: 1.5;
  }
  .pie__marca { display: flex; align-items: center; align-self: start; gap: 12px; }
  .pie__xb { width: 44px; color: var(--amarillo); }
  .pie__marca p {
    font-family: var(--fuente-display);
    font-size: var(--step-body);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }
  .pie h2 {
    font-family: var(--fuente-texto);
    font-size: var(--step-small);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.5;
    color: var(--amarillo);
  }
  .pie ul { margin: 0; }
  .pie a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
    transition: color 180ms ease;
  }
  .pie li { line-height: 1.3; }
  @media (hover: hover) and (pointer: fine) {
    .pie a:hover { color: var(--amarillo); }
  }
  .pie__base {
    grid-column: 1 / -1;
    display: grid;
    gap: 2px;
    max-width: 90ch;
    padding-top: 20px;
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--blanco) 18%, transparent);
    color: color-mix(in srgb, var(--blanco) 80%, var(--marino));
  }
  .pie__base address { font-style: normal; }

  @media (max-width: 899px) {
    .pie { grid-template-columns: 1fr; gap: 16px; padding-top: 40px; }
    .pie__col--instagram ul, .pie__col--legal ul { display: flex; flex-wrap: wrap; column-gap: 20px; }
    .pie__base { padding-top: 16px; }
  }
</style>
