---
/**
 * Barra fija y sencilla: monograma y marca de la página (vuelve al inicio), los apartados de la
 * página en escritorio y, siempre a la vista, el enlace a la otra marca.
 */
import { ruta } from '../lib/ruta';
import { t, type Idioma } from '../i18n/ui';
import LogoCup from './LogoCup.astro';
import Monograma from './Monograma.astro';

interface Enlace { href: string; texto: string }
interface Props {
  marca: string;
  /** Color de la barra: el de la marca de la página */
  capitulo: 'azul' | 'amarillo' | 'marino';
  /** Apartados de esta página (solo en escritorio) */
  enlaces?: Enlace[];
  /** La otra marca */
  otra: Enlace;
  idioma?: Idioma;
  /** Logo junto a la marca: el monograma de la academia (por defecto) o el de la Cup */
  logo?: 'academy' | 'cup';
}
const { marca, capitulo, enlaces = [], otra, idioma = 'es', logo = 'academy' } = Astro.props;
---
<header class="cabecera" data-capitulo={capitulo}>
  <a class="cabecera__marca" href={ruta('/')}>
    {logo === 'cup' ? <LogoCup class="cabecera__xb cabecera__xb--cup" /> : <Monograma class="cabecera__xb" />}
    <span>{marca}</span>
    <span class="solo-lector">({t(idioma, 'nav.inicio')})</span>
  </a>
  {enlaces.length > 0 && (
    <nav class="cabecera__nav" aria-label="En esta página">
      <ul role="list">
        {enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
      </ul>
    </nav>
  )}
  <a class="cabecera__otra" href={otra.href}>{otra.texto}</a>
</header>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 32px;
    height: var(--cabecera);
    padding-inline: var(--margen);
  }
  .cabecera__marca {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    min-height: 44px;
    font-family: var(--fuente-display);
    font-size: var(--step-lead);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  .cabecera__xb { width: 40px; height: auto; }
  /* Más alto que ancho que el monograma: misma altura óptica */
  .cabecera__xb--cup { width: 36px; }
  .cabecera__nav ul { display: flex; gap: 28px; margin: 0; }
  .cabecera__nav a {
    display: inline-block;
    padding-block: 10px;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color 180ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .cabecera__nav a:hover { text-decoration-color: currentColor; }
  }
  /* La otra marca: siempre visible, como un botón en la tinta de la barra */
  .cabecera__otra {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    font-family: var(--fuente-display);
    font-size: var(--step-body);
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    background: var(--tinta);
    color: var(--fondo);
    transition: transform 160ms var(--ease-out);
  }
  .cabecera__otra:active { transform: scale(0.97); }

  @media (max-width: 899px) {
    /* Los apartados bajan a una segunda fila, siempre a la vista (se desliza si no caben) */
    :global(:root:has(.cabecera__nav)) { --cabecera: 108px; }
    .cabecera { flex-wrap: wrap; gap: 0 12px; height: auto; min-height: 64px; padding-top: 10px; }
    .cabecera:has(.cabecera__nav) { padding-top: 10px; }
    .cabecera__nav {
      order: 3;
      flex-basis: calc(100% + var(--margen) * 2);
      margin-inline: calc(var(--margen) * -1);
      padding-inline: var(--margen);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .cabecera__nav::-webkit-scrollbar { display: none; }
    .cabecera__nav ul { gap: 20px; white-space: nowrap; }
    .cabecera__nav a { padding-block: 8px 10px; min-height: 44px; display: inline-flex; align-items: center; font-size: var(--step-small); text-decoration-color: currentColor; text-decoration-thickness: 1px; }
    .cabecera__marca { font-size: var(--step-body); }
    .cabecera__xb { width: 32px; }
    .cabecera__xb--cup { width: 30px; }
    .cabecera__otra { padding: 0 12px; font-size: var(--step-small); }
  }
</style>
