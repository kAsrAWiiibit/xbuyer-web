---
/**
 * Logo con eco: el logo, macizo, y detrás 4 copias solo con el contorno, cada una más transparente, desplazadas en
 * diagonal hacia arriba y a la derecha siguiendo el trazo «/» de la X (unos 51°), como una estela. Portada de la web.
 *
 * - Las copias repiten el trazo del logo con <use> (no se duplica el SVG) y no tapan nada: van detrás.
 * - Al cargar, salen del logo una tras otra hasta su sitio. En la portada empiezan cuando el título con chute ya está
 *   frenando (`retraso` 1100 ms), para que las dos animaciones no compitan; donde no hay chute, enseguida.
 *   emil-design-eng: ease-out fuerte, 520 ms cada una, 70 ms
 *   entre una y otra; solo translate y opacity (compositor). El logo no se mueve: no afecta al LCP ni al CLS.
 * - Con «Reducir movimiento», las copias ya están en su sitio, sin animación. Sin JavaScript funciona igual (CSS).
 */
import LogoCup from './LogoCup.astro';
import Monograma from './Monograma.astro';
import { COPIAS, estiloEco } from '../lib/eco';

interface Props {
  marca: 'academy' | 'cup';
  class?: string;
  /** Cuándo empiezan a salir las copias, en ms desde que se pinta */
  retraso?: number;
}
const { marca, class: clase, retraso = 150 } = Astro.props;
const id = `eco-${marca}`;
// viewBox y proporción de cada logo: el paso en diagonal se da en % del ancho y del alto de la copia
const LOGOS = {
  academy: { viewBox: '66 206 870 586', proporcion: 870 / 586, trazo: 7 },
  cup: { viewBox: '0 0 1944 1495', proporcion: 1944 / 1495, trazo: 15 },
};
const { viewBox, proporcion, trazo } = LOGOS[marca];
---
<span class:list={['eco', clase]} style={`${estiloEco(proporcion, retraso)}; --trazo: ${trazo}`} aria-hidden="true">
  {COPIAS.map((k) => (
    <svg class="eco__copia" style={`--k: ${k}`} viewBox={viewBox} xmlns="http://www.w3.org/2000/svg" focusable="false"><use href={`#${id}`} /></svg>
  ))}
  {marca === 'cup' ? <LogoCup class="eco__logo" idTrazo={id} /> : <Monograma class="eco__logo" idTrazo={id} />}
</span>

<style>
  .eco { position: relative; display: block; isolation: isolate; }
  .eco__logo { position: relative; display: block; width: 100%; height: auto; }
  .eco__copia {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: var(--trazo);
    stroke-linejoin: round;
    translate: calc(var(--k) * var(--paso-x)) calc(var(--k) * var(--paso-y));
    /* 0,43 · 0,32 · 0,21 · 0,10: se apaga a medida que se aleja */
    opacity: calc(0.54 - var(--k) * 0.11);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .eco__copia {
      animation: eco-sale 520ms cubic-bezier(0.23, 1, 0.32, 1) backwards;
      animation-delay: calc(var(--eco-retraso) + (var(--k) - 1) * 70ms);
    }
  }
  /* Sale de debajo del logo: desde su sitio, sin desplazar y transparente, hasta el suyo */
  @keyframes eco-sale {
    from { translate: 0 0; opacity: 0; }
  }
</style>
