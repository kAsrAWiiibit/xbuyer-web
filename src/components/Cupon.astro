---
/**
 * Contacto como cupón recortable. No envía nada a ningún servidor: abre el correo del visitante
 * con el mensaje escrito (mailto:) y, por si no hay programa de correo, enseña el email con
 * botones para copiar email y mensaje, y el Instagram de la marca. No guarda nada.
 */
import { entidad } from '../data/contenido';
import { t, type Idioma } from '../i18n/ui';

interface Props {
  marca: 'Xbuyer Cup' | 'Xbuyer Team Academy';
  instagram?: string | null;
  idioma?: Idioma;
  /** Tercer campo: club (Cup) o edad (Academy) */
  campoExtra?: { nombre: string; etiqueta: string; corto: string };
  /** id del título, para que la sección lo use como nombre */
  tituloId?: string;
  titulo?: string;
}
const { marca, instagram, idioma = 'es', campoExtra = { nombre: 'club', etiqueta: t(idioma, 'contacto.club'), corto: 'Club o equipo' }, tituloId, titulo = t(idioma, 'contacto.titulo') } = Astro.props;
const email = entidad.email;
---
<div class="cupon" data-cupon data-email={email} data-marca={marca}>
  <div class="cupon__talon">
    <h2 class="cupon__titulo" id={tituloId}>{titulo}</h2>
    <p class="cupon__texto" set:html={t(idioma, 'contacto.texto', { email: `<strong>${email}</strong>` })} />
  </div>

  <form class="cupon__form" action={`mailto:${email}?subject=${encodeURIComponent(marca)}`} method="post" enctype="text/plain" novalidate>
    <label class="cupon__campo">
      <span>{t(idioma, 'contacto.nombre')}</span>
      <input name="nombre" type="text" autocomplete="name" required />
    </label>
    <label class="cupon__campo">
      <span>{campoExtra.etiqueta}</span>
      <input name={campoExtra.nombre} type="text" autocomplete="off" data-extra={campoExtra.corto} />
    </label>
    <label class="cupon__campo">
      <span>{t(idioma, 'contacto.telefono')}</span>
      <input name="telefono" type="tel" autocomplete="tel" inputmode="tel" />
    </label>
    <label class="cupon__campo">
      <span>{t(idioma, 'contacto.mensaje')}</span>
      <textarea name="mensaje" rows="3" required></textarea>
    </label>
    <p class="cupon__error" role="alert" hidden data-error>{t(idioma, 'contacto.error')}</p>
    <button class="cupon__enviar" type="submit">{t(idioma, 'contacto.enviar')}</button>
  </form>

  <div class="cupon__plan-b" hidden data-plan-b tabindex="-1">
    <p>{t(idioma, 'contacto.planB')} <a class="enlace" href={`mailto:${email}`}>{email}</a></p>
    <div class="cupon__copiar">
      <button type="button" data-copiar="email" data-hecho={t(idioma, 'contacto.copiado')}>{t(idioma, 'contacto.copiarEmail')}</button>
      <button type="button" data-copiar="mensaje" data-hecho={t(idioma, 'contacto.copiado')}>{t(idioma, 'contacto.copiarMensaje')}</button>
      {instagram && <a href={`https://www.instagram.com/${instagram}/`} rel="noopener">Instagram @{instagram}</a>}
    </div>
    <button type="button" class="cupon__otra enlace" data-otra>{t(idioma, 'contacto.volver')}</button>
    <p class="solo-lector" aria-live="polite" data-aviso></p>
  </div>
</div>

<script>
  for (const cupon of document.querySelectorAll<HTMLElement>('[data-cupon]')) {
    const form = cupon.querySelector('form')!;
    const planB = cupon.querySelector<HTMLElement>('[data-plan-b]')!;
    const error = cupon.querySelector<HTMLElement>('[data-error]')!;
    const aviso = cupon.querySelector<HTMLElement>('[data-aviso]')!;
    const { email = '', marca = '' } = cupon.dataset;
    let mensaje = '';

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const datos = new FormData(form);
      const valor = (k: string) => String(datos.get(k) ?? '').trim();
      const nombre = valor('nombre');
      const texto = valor('mensaje');
      if (!nombre || !texto) {
        error.hidden = false;
        form.querySelector<HTMLElement>(!nombre ? '[name="nombre"]' : '[name="mensaje"]')?.focus();
        return;
      }
      error.hidden = true;
      const extra = form.querySelector<HTMLInputElement>('[data-extra]');
      const firma = [
        nombre,
        extra?.value.trim() && `${extra.dataset.extra}: ${extra.value.trim()}`,
        valor('telefono') && `Teléfono: ${valor('telefono')}`,
      ].filter(Boolean);
      mensaje = ['Hola,', '', texto, '', ...firma].join('\n');
      const asunto = `${marca} · Consulta de ${nombre}`;
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(mensaje)}`;
      planB.hidden = false;
      cupon.classList.add('cupon--enviado');
      planB.focus({ preventScroll: true });
    });

    cupon.querySelector('[data-otra]')?.addEventListener('click', () => {
      cupon.classList.remove('cupon--enviado');
      planB.hidden = true;
      form.querySelector<HTMLElement>('[name="mensaje"]')?.focus();
    });

    for (const boton of cupon.querySelectorAll<HTMLButtonElement>('[data-copiar]')) {
      const original = boton.textContent ?? '';
      boton.addEventListener('click', async () => {
        const texto = boton.dataset.copiar === 'email' ? email : mensaje;
        try {
          await navigator.clipboard.writeText(texto);
        } catch {
          // Sin permiso de portapapeles: deja el texto seleccionable
          window.prompt(original, texto);
          return;
        }
        boton.textContent = boton.dataset.hecho ?? original;
        boton.classList.add('hecho');
        aviso.textContent = `${original}: ${boton.dataset.hecho}`;
        setTimeout(() => {
          boton.textContent = original;
          boton.classList.remove('hecho');
        }, 1800);
      });
    }
  }
</script>

<style>
  .cupon {
    --perforacion: 42%;
    position: relative;
    display: grid;
    grid-template-columns: var(--perforacion) 1fr;
    background: var(--amarillo);
    color: var(--marino);
    /* El anillo de foco, en marino sobre el amarillo del cupón */
    --acento: var(--marino);
  }
  .cupon__talon {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 48px;
  }
  .cupon__titulo {
    font-size: var(--step-head);
    text-transform: uppercase;
  }
  .cupon__texto { max-width: 32ch; }

  .cupon__form,
  .cupon__plan-b {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    gap: 10px;
    padding: 48px;
  }
  .cupon__campo { display: grid; gap: 4px; }
  .cupon__campo span { font-weight: 500; }
  .cupon__campo input,
  .cupon__campo textarea {
    width: 100%;
    min-height: 52px;
    padding: 12px 14px;
    border: 2px solid var(--marino);
    border-radius: 0;
    background: var(--blanco);
    color: var(--marino);
    font-size: max(16px, var(--step-body));
    transition: border-color 160ms ease;
  }
  .cupon__campo textarea { resize: vertical; min-height: 104px; }
  .cupon__campo input:focus-visible,
  .cupon__campo textarea:focus-visible { outline: 3px solid var(--azul); outline-offset: 0; }
  .cupon__error { font-weight: 500; }
  .cupon__enviar {
    min-height: 56px;
    margin-top: 6px;
    border: 0;
    border-radius: 0;
    background: var(--marino);
    color: var(--amarillo);
    font-family: var(--fuente-display);
    font-size: var(--step-lead);
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 160ms var(--ease-out), background-color 200ms ease, color 200ms ease;
  }
  .cupon__enviar:active { transform: scale(0.98); }
  @media (hover: hover) and (pointer: fine) {
    .cupon__enviar:hover { background: var(--azul); color: var(--blanco); }
  }

  .cupon__plan-b { align-content: start; gap: 20px; outline: none; }
  .cupon__plan-b[hidden], .cupon__error[hidden] { display: none; }
  .cupon--enviado .cupon__form { display: none; }
  .cupon__plan-b p { font-size: var(--step-lead); line-height: 1.3; }
  .cupon__plan-b p a { overflow-wrap: anywhere; }
  .cupon__copiar { display: flex; flex-wrap: wrap; gap: 10px; }
  .cupon__copiar :is(button, a) {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 18px;
    border: 0;
    border-radius: 0;
    background: var(--marino);
    color: var(--amarillo);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: transform 160ms var(--ease-out), background-color 200ms ease, color 200ms ease;
  }
  .cupon__copiar :is(button, a):active { transform: scale(0.97); }
  .cupon__copiar .hecho { background: var(--azul); color: var(--blanco); }
  .cupon__otra { justify-self: start; min-height: 44px; padding: 0; border: 0; background: none; cursor: pointer; }

  @media (max-width: 899px) {
    .cupon { grid-template-columns: 1fr; }
    .cupon__talon { padding: 28px 24px; }
    .cupon__form,
    .cupon__plan-b { grid-column: 1; grid-row: 2; padding: 28px 24px; }
    .cupon__campo input, .cupon__campo textarea { min-height: 54px; }
  }
</style>
