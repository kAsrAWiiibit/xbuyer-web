---
/**
 * Líneas de un campo de fútbol 11 (105 × 68 m, medidas reglamentarias) en SVG. Decoración: va
 * detrás del contenido y los lectores de pantalla lo ignoran. Cuando asoma, las líneas se trazan
 * una vez (stroke-dashoffset, de fuera adentro). Sin JavaScript, con «Reducir movimiento» o con
 * ahorro de datos, el campo ya está dibujado.
 */
interface Props { class?: string; /** Medio campo: solo la mitad izquierda, para huecos estrechos */ medio?: boolean }
const { class: clase, medio = false } = Astro.props;

// Medidas en metros
const L = 105, A = 68, c = A / 2;
const area = { fondo: 16.5, ancho: 40.32 };
const areaChica = { fondo: 5.5, ancho: 18.32 };
const penalti = 11, radio = 9.15;
// Arco del área: la parte del círculo de radio 9,15 desde el punto de penalti que queda fuera del área
const dx = area.fondo - penalti;
const dy = Math.sqrt(radio * radio - dx * dx);
const vista = medio ? `-1 -1 ${L / 2 + 2} ${A + 2}` : `-1 -1 ${L + 2} ${A + 2}`;
---
<svg class:list={['campo', clase]} data-campo data-centro={`${L / 2} ${c}`} data-medidas={`${L} ${A}`} viewBox={vista} preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <g fill="none" stroke="currentColor" stroke-linecap="square">
    <rect style="--o: 0" pathLength="1" x="0" y="0" width={L} height={A} />
    <path style="--o: 1" pathLength="1" d={`M ${L / 2} 0 V ${A}`} />
    <circle style="--o: 2" pathLength="1" cx={L / 2} cy={c} r={radio} />
    {[0, 1].map((lado) => {
      const x = lado ? L : 0, s = lado ? -1 : 1;
      return (
        <>
          <path style="--o: 1" pathLength="1" d={`M ${x} ${c - area.ancho / 2} H ${x + s * area.fondo} V ${c + area.ancho / 2} H ${x}`} />
          <path style="--o: 2" pathLength="1" d={`M ${x} ${c - areaChica.ancho / 2} H ${x + s * areaChica.fondo} V ${c + areaChica.ancho / 2} H ${x}`} />
          <path style="--o: 3" pathLength="1" d={`M ${x + s * area.fondo} ${c - dy} A ${radio} ${radio} 0 0 ${lado ? 0 : 1} ${x + s * area.fondo} ${c + dy}`} />
          <path style="--o: 3" pathLength="1" d={`M ${x} 1 A 1 1 0 0 ${lado ? 0 : 1} ${x + s} 0 M ${x} ${A - 1} A 1 1 0 0 ${lado ? 1 : 0} ${x + s} ${A}`} />
        </>
      );
    })}
  </g>
  <g fill="currentColor" class="campo__puntos">
    <circle cx={L / 2} cy={c} r="0.5" />
    <circle cx={penalti} cy={c} r="0.4" />
    <circle cx={L - penalti} cy={c} r="0.4" />
  </g>
  <!-- El balón: aparece en el centro cuando el campo ya está dibujado y, con ratón, va hacia el puntero -->
  <g class="campo__balon" data-balon transform={`translate(${L / 2} ${c})`}>
    <circle r="1.25" fill="var(--amarillo)" />
    <path d="M0-.55.52-.17.32.45H-.32L-.52-.17Z" fill="var(--marino)" />
  </g>
</svg>

<script>
  const quieto =
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
    (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true ||
    !('IntersectionObserver' in window);
  for (const campo of document.querySelectorAll<SVGSVGElement>('[data-campo]')) {
    if (quieto) continue;
    balon(campo);
    if (campo.getBoundingClientRect().top < window.innerHeight * 0.85) {
      campo.classList.add('campo--listo');
      continue;
    }
    campo.classList.add('campo--espera');
    const obs = new IntersectionObserver(
      ([v]) => {
        if (!v.isIntersecting) return;
        requestAnimationFrame(() => campo.classList.replace('campo--espera', 'campo--traza'));
        setTimeout(() => campo.classList.add('campo--listo'), 1700);
        obs.disconnect();
      },
      { threshold: 0.25 },
    );
    obs.observe(campo);
  }

  /** El balón sigue al puntero por el campo (con ratón) o va adonde se toca, rodando; al salir, vuelve al centro */
  function balon(campo: SVGSVGElement) {
    const b = campo.querySelector<SVGGElement>('[data-balon]');
    const zona = campo.parentElement;
    if (!b || !zona) return;
    const [cx, cy] = campo.dataset.centro!.split(' ').map(Number);
    const [L, A] = campo.dataset.medidas!.split(' ').map(Number);
    let x = cx, y = cy, tx = cx, ty = cy, giro = 0, animando = false;
    const paso = () => {
      const nx = x + (tx - x) * 0.06, ny = y + (ty - y) * 0.06;
      giro += Math.hypot(nx - x, ny - y) * 45 * Math.sign(nx - x || 1);
      x = nx; y = ny;
      b.setAttribute('transform', `translate(${x.toFixed(2)} ${y.toFixed(2)}) rotate(${giro.toFixed(1)})`);
      animando = Math.hypot(tx - x, ty - y) > 0.02;
      if (animando) requestAnimationFrame(paso);
    };
    const apunta = (e: PointerEvent) => {
      if (!campo.classList.contains('campo--listo')) return;
      const m = campo.getScreenCTM();
      if (!m) return;
      const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse());
      tx = Math.min(Math.max(p.x, 1.5), L - 1.5);
      ty = Math.min(Math.max(p.y, 1.5), A - 1.5);
      if (!animando) { animando = true; requestAnimationFrame(paso); }
    };
    zona.addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') apunta(e); }, { passive: true });
    zona.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') apunta(e); }, { passive: true });
    zona.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      tx = cx; ty = cy;
      if (!animando) { animando = true; requestAnimationFrame(paso); }
    });
  }
</script>

<style>
  .campo { display: block; overflow: visible; }
  /* Grosor en metros del dibujo (0,25 ≈ 2 px a 900 px de ancho) */
  .campo g[stroke] > * { stroke-width: var(--grosor, 0.25); }
  /* Antes de asomar, ninguna línea; al asomar, se trazan de fuera adentro y luego aparecen los puntos */
  .campo--espera g[stroke] > * { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .campo--espera .campo__puntos { opacity: 0; }
  .campo--traza g[stroke] > * {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1100ms var(--ease-in-out);
    transition-delay: calc(var(--o) * 260ms);
  }
  .campo--traza .campo__puntos { transition: opacity 400ms ease 1500ms; }
  /* El balón solo existe con movimiento: aparece cuando el campo está dibujado */
  .campo__balon { opacity: 0; transition: opacity 400ms ease; }
  .campo--listo .campo__balon { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .campo__balon { display: none; }
    .campo g[stroke] > * { transition: none !important; stroke-dashoffset: 0 !important; }
    .campo__puntos { opacity: 1 !important; }
  }
</style>
