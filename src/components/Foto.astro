---
/**
 * Hueco de foto con el corte diagonal de la X. Lee src/data/fotos.json: con foto, la muestra (el
 * crédito va agrupado en la sección, con Creditos.astro, y en el pie de la página); sin foto (null), el monograma sobre color plano, para que la página se vea completa.
 * Añadir una foto no cambia el tamaño ni la composición del hueco.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import { fotoDe, type Hueco } from '../lib/fotos';
import Monograma from './Monograma.astro';

interface Props {
  hueco: Hueco;
  /** Proporción ancho/alto, p. ej. '4 / 5' */
  proporcion?: string;
  /** Color del hueco vacío */
  fondo?: 'azul' | 'marino' | 'amarillo' | 'blanco';
  sizes?: string;
  prioridad?: boolean;
  class?: string;
}

const { hueco, proporcion = '4 / 5', fondo = 'marino', sizes = '(min-width: 900px) 40vw, 100vw', prioridad = false, class: clase } = Astro.props;

const archivos = import.meta.glob<ImageMetadata>('/src/fotos/**/*.{jpg,jpeg,png,webp,avif}', { eager: true, import: 'default' });
const foto = fotoDe(hueco);
const src = foto ? archivos[`/src/fotos/${foto.archivo}`] : undefined;
if (foto && !src) throw new Error(`fotos.json: no existe src/fotos/${foto.archivo} (hueco ${hueco})`);
if (foto && (!foto.alt?.trim() || !foto.autor?.trim())) throw new Error(`fotos.json: al hueco ${hueco} le falta alt o autor`);
---
<figure class:list={['foto', `foto--${fondo}`, !foto && 'foto--vacia', clase]} style={`--proporcion: ${proporcion}`}>
  {foto && src ? (
    <>
      <Image src={src} alt={foto.alt} widths={[480, 800, 1200, 1600]} sizes={sizes} loading={prioridad ? 'eager' : 'lazy'} fetchpriority={prioridad ? 'high' : undefined} />
    </>
  ) : (
    <Monograma class="foto__monograma" />
  )}
</figure>
