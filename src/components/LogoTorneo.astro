---
/**
 * Logo de un torneo (src/fotos/torneos/), sin recuadro: PNG transparente directamente sobre el fondo de la página.
 * `fondo` dice sobre qué va: si existe `<logo>--oscuro.png` o `<logo>--claro.png` (versiones en blanco, o con las
 * partes blancas en marino, de scripts/logos-torneos.mjs), se usa esa. Sin logo, el nombre en letra de cartel.
 *
 * `eco` (portada de la página de cada torneo): detrás del logo, las 4 copias en contorno del efecto eco de la portada
 * de la web (src/lib/eco.ts). Cada copia es el contorno del logo (`<logo>--contorno.png`) usado como máscara, en el
 * color del texto. Salen del logo al cargar (solo translate y opacity); con «Reducir movimiento», ya colocadas.
 * La alineación del logo dentro de su caja la da `--logo-pos` (por defecto, centrado); las copias la siguen.
 *
 * Con `eco`, el logo está arriba: se pide enseguida y con prioridad alta.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { COPIAS, estiloEco } from '../lib/eco';

interface Props {
  logo: string | null;
  nombre: string;
  /** Fondo sobre el que va: oscuro (azul, marino) o claro (amarillo, blanco) */
  fondo: 'oscuro' | 'claro';
  /** Ancho máximo que ocupa en pantalla, para elegir el tamaño de la imagen */
  sizes?: string;
  class?: string;
  /** Con copias en contorno detrás (efecto eco). El logo se carga enseguida: está arriba */
  eco?: boolean;
}
const { logo, nombre, fondo, sizes = '200px', class: clase, eco = false } = Astro.props;
const archivos = import.meta.glob<ImageMetadata>('/src/fotos/torneos/*.png', { eager: true, import: 'default' });
const ruta = (archivo: string) => `/src/fotos/torneos/${archivo}`;
const src = logo ? (archivos[ruta(logo.replace('.png', `--${fondo}.png`))] ?? archivos[ruta(logo)]) : undefined;
if (logo && !src) throw new Error(`LogoTorneo: no existe src/fotos/torneos/${logo}`);
const contorno = eco && logo ? archivos[ruta(logo.replace('.png', '--contorno.png'))] : undefined;
if (eco && logo && !contorno) throw new Error(`LogoTorneo: falta el contorno de ${logo}. Ejecuta «node scripts/logos-torneos.mjs».`);
// La caja es 3:2: el paso del eco en % de su ancho y de su alto
const estilo = contorno ? `${estiloEco(3 / 2, 150)}; --contorno: url(${contorno.src})` : undefined;
---
<div class:list={['logo-torneo', !src && 'logo-torneo--nombre', contorno && 'logo-torneo--eco', clase]} style={estilo}>
  {src ? (
    <div class="logo-torneo__marco">
      {contorno && COPIAS.map((k) => <span class="logo-torneo__copia" style={`--k: ${k}`} aria-hidden="true"></span>)}
      <Image src={src} alt={`Logo de ${nombre}`} widths={[160, 320, 480, 640]} sizes={sizes} loading={eco ? 'eager' : 'lazy'} fetchpriority={eco ? 'high' : undefined} />
    </div>
  ) : <span aria-hidden="true">{nombre}</span>}
</div>

<style>
  .logo-torneo {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    min-height: 0;
    color: var(--tinta);
  }
  .logo-torneo__marco { position: absolute; inset: 12%; isolation: isolate; }
  .logo-torneo__marco :global(img) {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: var(--logo-pos, center);
  }
  .logo-torneo--nombre { padding: 10%; }
  .logo-torneo--nombre span {
    font-family: var(--fuente-display);
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
    font-weight: 700;
    line-height: 0.9;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* Eco: las copias, el contorno del logo en el color de acento, detrás y cada vez más lejos y más transparentes */
  .logo-torneo__copia {
    position: absolute;
    inset: 0;
    background: var(--tinta-2);
    -webkit-mask: var(--contorno) var(--logo-pos, center) / contain no-repeat;
    mask: var(--contorno) var(--logo-pos, center) / contain no-repeat;
    translate: calc(var(--k) * var(--paso-x)) calc(var(--k) * var(--paso-y));
    /* 0,32 · 0,24 · 0,16 · 0,08: más suaves que en la portada, porque los logos de texto tienen muchos contornos */
    opacity: calc(0.4 - var(--k) * 0.08);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .logo-torneo__copia {
      animation: eco-sale 520ms cubic-bezier(0.23, 1, 0.32, 1) backwards;
      animation-delay: calc(var(--eco-retraso) + (var(--k) - 1) * 70ms);
    }
  }
  @keyframes eco-sale {
    from { translate: 0 0; opacity: 0; }
  }
</style>
