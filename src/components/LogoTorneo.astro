---
/**
 * Logo de un torneo (src/fotos/torneos/), sin recuadro: PNG transparente directamente sobre el fondo de la página.
 * `fondo` dice sobre qué va: si existe `<logo>--oscuro.png` o `<logo>--claro.png` (versiones en blanco, o con las
 * partes blancas en marino, de scripts/logos-torneos.mjs), se usa esa. Sin logo, el nombre en letra de cartel.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  logo: string | null;
  nombre: string;
  /** Fondo sobre el que va: oscuro (azul, marino) o claro (amarillo, blanco) */
  fondo: 'oscuro' | 'claro';
  /** Ancho máximo que ocupa en pantalla, para elegir el tamaño de la imagen */
  sizes?: string;
  class?: string;
}
const { logo, nombre, fondo, sizes = '200px', class: clase } = Astro.props;
const archivos = import.meta.glob<ImageMetadata>('/src/fotos/torneos/*.png', { eager: true, import: 'default' });
const ruta = (archivo: string) => `/src/fotos/torneos/${archivo}`;
const src = logo ? (archivos[ruta(logo.replace('.png', `--${fondo}.png`))] ?? archivos[ruta(logo)]) : undefined;
if (logo && !src) throw new Error(`LogoTorneo: no existe src/fotos/torneos/${logo}`);
---
<div class:list={['logo-torneo', !src && 'logo-torneo--nombre', clase]}>
  {src ? <Image src={src} alt={`Logo de ${nombre}`} widths={[160, 320, 480, 640]} sizes={sizes} loading="lazy" /> : <span aria-hidden="true">{nombre}</span>}
</div>

<style>
  .logo-torneo {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    min-height: 0;
    color: var(--tinta);
  }
  .logo-torneo img { position: absolute; inset: 12%; width: 76%; height: 76%; object-fit: contain; }
  .logo-torneo--nombre { padding: 10%; }
  .logo-torneo--nombre span {
    font-family: var(--fuente-display);
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
    font-weight: 700;
    line-height: 0.9;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }
</style>
