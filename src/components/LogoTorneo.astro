---
/**
 * Logo de un torneo (src/fotos/torneos/) sobre un recuadro plano, o su nombre en letra de cartel si no hay logo.
 * El recuadro es blanco, o marino si el logo tiene partes blancas.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  logo: string | null;
  nombre: string;
  fondo?: 'blanco' | 'marino';
  /** Ancho máximo que ocupa en pantalla, para elegir el tamaño de la imagen */
  sizes?: string;
  class?: string;
}
const { logo, nombre, fondo = 'blanco', sizes = '200px', class: clase } = Astro.props;
const archivos = import.meta.glob<ImageMetadata>('/src/fotos/torneos/*.png', { eager: true, import: 'default' });
const src = logo ? archivos[`/src/fotos/torneos/${logo}`] : undefined;
if (logo && !src) throw new Error(`LogoTorneo: no existe src/fotos/torneos/${logo}`);
---
<div class:list={['logo-torneo', `logo-torneo--${fondo}`, !src && 'logo-torneo--nombre', clase]}>
  {src ? <Image src={src} alt={`Logo de ${nombre}`} widths={[160, 320, 480]} sizes={sizes} loading="lazy" /> : <span aria-hidden="true">{nombre}</span>}
</div>

<style>
  .logo-torneo {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    min-height: 0;
    overflow: hidden;
    background: var(--blanco);
    color: var(--marino);
  }
  .logo-torneo--marino { background: var(--marino); color: var(--blanco); }
  .logo-torneo img { position: absolute; inset: 14%; width: 72%; height: 72%; object-fit: contain; }
  .logo-torneo--nombre { padding: 10%; }
  .logo-torneo--nombre span {
    font-family: var(--fuente-display);
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
    font-weight: 700;
    line-height: 0.9;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }
</style>
