---
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '../styles/global.css';
// Las dos fuentes de la primera pantalla, precargadas para que el texto no salte al llegar
import fuenteTitulos from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import fuenteTexto from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';

import Pie from '../components/Pie.astro';
import { VISTA_PREVIA } from '../data/sitio.mjs';
import { t, type Idioma } from '../i18n/ui';

interface Props {
  titulo: string;
  descripcion: string;
  idioma?: Idioma;
  /** Color de la barra del navegador en móvil */
  colorTema?: string;
  /** Imagen para compartir (public/compartir/<nombre>.png) */
  compartir?: 'inicio' | 'academy' | 'cup';
  /** Fuera de buscadores (la 404) */
  indexar?: boolean;
  /** Huecos de foto de la página: sus autores salen en el pie */
  fotos?: string[];
}
const { titulo, descripcion, idioma = 'es', colorTema = '#1863B8', compartir = 'inicio', fotos = [] } = Astro.props;
// La vista previa nunca se indexa
const indexar = Astro.props.indexar !== false && !VISTA_PREVIA;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const absoluta = (ruta: string) => (Astro.site ? new URL(ruta, Astro.site).href : ruta);
const canonica = Astro.site && indexar ? absoluta(Astro.url.pathname) : undefined;
const imagen = absoluta(`${base}/compartir/${compartir}.png`);
---
<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <link rel="preload" href={fuenteTitulos} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuenteTexto} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={descripcion} />
    {canonica && <link rel="canonical" href={canonica} />}
    <meta name="theme-color" content={colorTema} />
    {!indexar && <meta name="robots" content={VISTA_PREVIA ? 'noindex, nofollow' : 'noindex'} />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    {Astro.site && <link rel="sitemap" href={absoluta(`${base}/sitemap.xml`)} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Xbuyer Team Academy" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {canonica && <meta property="og:url" content={canonica} />}
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={titulo} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">{t(idioma, 'saltar')}</a>
    <slot name="cabecera" />
    <main id="contenido">
      <slot />
    </main>
    <Pie idioma={idioma} fotos={fotos} />

    <script>
      // Entradas: las partes de cada sección suben un poco y aparecen, en orden y una sola vez.
      // Sin este script (o con movimiento reducido) todo se ve desde el principio.
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const secciones = document.querySelectorAll<HTMLElement>('main > section:not(:first-child)');
        const observador = new IntersectionObserver(
          (vistas) => {
            for (const v of vistas) {
              if (!v.isIntersecting) continue;
              v.target.classList.add('visto');
              observador.unobserve(v.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        for (const seccion of secciones) {
          seccion.querySelectorAll<HTMLElement>(':scope > *').forEach((el, i) => el.style.setProperty('--i', String(Math.min(i, 4))));
          observador.observe(seccion);
        }
        document.documentElement.classList.add('mov');
      }
    </script>
  </body>
</html>
