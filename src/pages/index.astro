---
/** Portada: solo los dos caminos, la academia y la Cup, y el pie */
import LogoCup from '../components/LogoCup.astro';
import Monograma from '../components/Monograma.astro';
import TituloChute from '../components/TituloChute.astro';
import { academy, cup } from '../data/contenido';
import { t } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import { ruta } from '../lib/ruta';
---
<Base
  titulo={`${academy.nombre} · ${cup.nombre}`}
  descripcion={`${academy.frase} ${cup.frase}`}
  colorTema="#FFED00"
>
  <h1 class="solo-lector">{academy.nombre} y {cup.nombre}</h1>
  <div class="caminos">
    <a class="camino" data-capitulo="amarillo" href={ruta('/academy/')}>
      <Monograma class="camino__xb" />
      <TituloChute as="h2" class="camino__nombre" lineas={['Xbuyer Team', 'Academy']} />
      <p class="camino__frase">{academy.frase}</p>
      <span class="boton camino__boton">{t('es', 'inicio.academy.boton')}</span>
    </a>
    <a class="camino" data-capitulo="azul" href={ruta('/cup/')}>
      <LogoCup class="camino__xb camino__xb--cup" />
      <TituloChute as="h2" class="camino__nombre" lineas={['Xbuyer', 'Cup']} />
      <p class="camino__frase">{cup.frase}</p>
      <span class="boton camino__boton">{t('es', 'inicio.cup.boton')}</span>
    </a>
  </div>
</Base>

<style>
  .caminos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100svh;
  }
  .camino {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 28px;
    padding: clamp(48px, 8vw, 112px) clamp(24px, 5vw, 80px);
    text-decoration: none;
  }
  .camino__xb { width: clamp(64px, 7vw, 104px); height: auto; color: var(--tinta-2); }
  /* El logo de la Cup es más alto: misma altura que el monograma */
  .camino__xb--cup { width: clamp(58px, 6.3vw, 94px); }
  .camino__nombre {
    font-size: clamp(3.5rem, 1rem + 7vw, 8.5rem);
    line-height: 0.85;
    text-transform: uppercase;
  }
  .camino__nombre :global(.linea + .linea) { color: var(--tinta-2); }
  .camino__frase { max-width: 36ch; font-size: var(--step-lead); line-height: 1.3; }
  .camino__boton { margin-top: 8px; }
  @media (hover: hover) and (pointer: fine) {
    .camino:hover .camino__boton { background: var(--tinta); color: var(--fondo); }
  }
  .camino:active .camino__boton { transform: scale(0.97); }
  .camino:focus-visible { outline-offset: -8px; }

  @media (max-width: 899px) {
    .caminos { grid-template-columns: 1fr; min-height: 0; }
    .camino { min-height: 50svh; gap: 20px; }
  }
</style>
