---
/**
 * Xbuyer Team Academy: quiénes son, los torneos 2027 (cada uno con su página), el palmarés, la equipación de la
 * temporada y contacto. Textos de contenido/textos.md; torneos de src/data/torneos-2027.ts; equipación de
 * src/data/equipacion.ts.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import Cabecera from '../../components/Cabecera.astro';
import Cupon from '../../components/Cupon.astro';
import Dato from '../../components/Dato.astro';
import Foto from '../../components/Foto.astro';
import LogoTorneo from '../../components/LogoTorneo.astro';
import Marcador from '../../components/Marcador.astro';
import Monograma from '../../components/Monograma.astro';
import { academy, cup } from '../../data/contenido';
import { extras, piezas as datosPiezas } from '../../data/equipacion';
import { preinscripcion } from '../../data/preinscripcion';
import { torneos } from '../../data/torneos-2027';
import { t } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import { euros, rango } from '../../lib/fechas';
import { autores, fotoDe, type Hueco } from '../../lib/fotos';
import { ruta } from '../../lib/ruta';
import { fondoLogo, menuAcademia, nombreCompleto, rutaTorneo } from '../../lib/torneos';

const palmares = academy.palmares;
/** «2025 · B12»; si hay más de un título, solo es uno de ellos */
const detalle = (p: (typeof palmares)[number]) => {
  const texto = [p.anio, p.categoria].filter(Boolean).join(' · ');
  return texto && p.titulos > 1 ? t('es', 'academy.palmares.entreEllos', { detalle: texto }) : texto;
};
/** La cifra grande de cada torneo: sus títulos, «2.º» si fue subcampeón; nada si fue participación */
// Los trofeos (src/fotos/trofeos/, recortados de las imágenes del palmarés de la organización), por el logo del torneo
const trofeos = import.meta.glob<ImageMetadata>('/src/fotos/trofeos/*.png', { eager: true, import: 'default' });
const conTrofeo = palmares.flatMap((p) => (trofeos[`/src/fotos/trofeos/${p.logo}`] ? [{ ...p, trofeo: trofeos[`/src/fotos/trofeos/${p.logo}`] }] : []));
const sinTrofeo = palmares.filter((p) => !trofeos[`/src/fotos/trofeos/${p.logo}`]);
const cifra = (p: (typeof palmares)[number]) => (p.titulos >= 1 ? String(p.titulos) : p.titulos === 0.5 ? '2.º' : null);

// Cada pieza con su foto; si hay foto de la espalda, se le puede dar la vuelta
const { equipacion } = academy;
const piezas = datosPiezas.map((p) => {
  const hueco = `equipacion-${p.id}`;
  if (!fotoDe(hueco)) throw new Error(`fotos.json: falta la foto de la equipación «${p.nombre}» (hueco ${hueco})`);
  return { ...p, hueco, espalda: fotoDe(`${hueco}-espalda`) ? `${hueco}-espalda` : null };
});
// «Equipaciones 2026/2027, con Adidas como…»: la marca va en negrita
const frase = t('es', 'academy.equipacion.frase', { temporada: equipacion.temporada, marca: '\u0000' }).split('\u0000');
const imagenes = import.meta.glob<ImageMetadata>('/src/fotos/equipacion/*.png', { eager: true, import: 'default' });
const imagenExtra = (archivo: string) => imagenes[`/src/fotos/${archivo}`] ?? (() => { throw new Error(`equipacion.ts: no existe src/fotos/${archivo}`); })();

// Marcador: lo que suman los resultados de textos.md (campeones cuenta 1; «N veces campeones», N)
const titulos = palmares.reduce((n, p) => n + (Number.isInteger(p.titulos) ? p.titulos : 0), 0);
const subcampeonatos = palmares.filter((p) => p.titulos === 0.5).length;
const plural = (n: number, uno: Parameters<typeof t>[1], varios: Parameters<typeof t>[1]) => t('es', n === 1 ? uno : varios);
const cifras = [
  { valor: titulos, etiqueta: plural(titulos, 'academy.marcador.titulo', 'academy.marcador.titulos') },
  { valor: subcampeonatos, etiqueta: plural(subcampeonatos, 'academy.marcador.subcampeonato', 'academy.marcador.subcampeonatos') },
  { valor: palmares.length, etiqueta: plural(palmares.length, 'academy.marcador.torneo', 'academy.marcador.torneos') },
].filter((c) => c.valor > 0);
// El titular dice «más de 20»: si el palmarés bajara de ahí, la build avisa
if (/más de 20/i.test(academy.titularPalmares) && titulos <= 20) throw new Error(`textos.md: el titular del palmarés dice «más de 20» y suman ${titulos}`);

// Huecos con foto de la página, para los créditos
const huecosEquipacion = piezas.flatMap((p) => [p.hueco, ...(p.espalda ? [p.espalda] : [])]);

// Los apartados de la página son anclas; el desplegable lleva a la página de cada torneo
const enlaces = menuAcademia((c) => t('es', c), { enPortada: true });
---
<Base titulo={`${academy.nombre} · ${t('es', 'academy.tituloPagina')}`} descripcion={academy.frase} colorTema="#FFED00" compartir="academy" fotos={huecosEquipacion}>
  <Cabecera slot="cabecera" marca={academy.nombre} capitulo="amarillo" enlaces={enlaces} otra={{ href: ruta('/cup/'), texto: cup.nombre }} />

  <section class="portada" data-capitulo="amarillo" aria-labelledby="portada-titulo">
    <div class="portada__texto">
      <h1 id="portada-titulo" class="portada__titulo"><span>Xbuyer Team</span> <span>Academy</span></h1>
      <a class="boton portada__pre" href={ruta('/academy/preinscripcion/')}>{t('es', 'academy.preinscripcion.boton')}<span class="portada__temporada">{preinscripcion.temporada}</span></a>
    </div>
    <Monograma class="portada__xb" />
  </section>

  <section class="bloque quienes" id="quienes" data-capitulo="blanco" aria-labelledby="quienes-titulo">
    <h2 id="quienes-titulo" class="bloque__titulo">{t('es', 'academy.quienes')}</h2>
    <div class="quienes__texto">
      {academy.quienes.split(/(?<=\.)\s+(?=\p{Lu})/u).map((frase, i) => <p class:list={['quienes__frase', i === 0 && 'quienes__frase--primera']}>{frase}</p>)}
    </div>
  </section>

  <section class="bloque torneos" id="torneos" data-capitulo="azul" aria-labelledby="torneos-titulo">
    <div class="torneos__cabeza">
      <h2 id="torneos-titulo" class="bloque__titulo">{t('es', 'academy.torneos')}</h2>
      <p class="torneos__intro">{t('es', 'academy.torneos.intro')}</p>
    </div>
    <ol role="list" class="torneos__lista">
      {torneos.map((tr) => (
        <li>
          <a class="tarjeta" href={rutaTorneo(tr)}>
            <LogoTorneo logo={tr.logo} nombre={tr.nombre} fondo={fondoLogo(tr.logo)} class="tarjeta__logo" sizes="(min-width: 1100px) 22vw, (min-width: 600px) 45vw, 40vw" />
            <span class="tarjeta__texto">
              <span class="tarjeta__nombre">{tr.nombre}{tr.edicion && <span class="tarjeta__edicion">{tr.edicion}</span>}</span>
              <span class="tarjeta__fechas"><time datetime={tr.inicio}>{rango(tr.inicio, tr.fin)}</time></span>
              <span class="tarjeta__lugar">{tr.lugar}</span>
            </span>
            <svg class="tarjeta__flecha" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="bloque palmares" id="palmares" data-capitulo="marino" aria-labelledby="palmares-titulo">
    <div class="palmares__cabeza">
      <h2 id="palmares-titulo" class="bloque__titulo palmares__titular">{academy.titularPalmares}</h2>
      <p class="palmares__texto">{academy.textoPalmares}</p>
    </div>
    <Marcador cifras={cifras} titulo={t('es', 'academy.marcador')} />
    <ol role="list" class="vitrina" aria-label={t('es', 'academy.vitrina')}>
      {conTrofeo.map((p, i) => (
        <li class="trofeo" style={`--i: ${i}`}>
          <div class="trofeo__pieza">
            <Image src={p.trofeo} alt={t('es', 'academy.trofeoAlt', { torneo: p.torneo })} widths={[240, 400, 600]} sizes="(min-width: 900px) 22vw, 56vw" loading="lazy" class="trofeo__img" />
            <span class="trofeo__sombra" aria-hidden="true"></span>
          </div>
          <div class="trofeo__peana">
            <p class="trofeo__cifra">{cifra(p)}</p>
            <p class="trofeo__resultado">{p.resultado}</p>
          </div>
          <h3 class="trofeo__nombre">{p.torneo}</h3>
          {(detalle(p) || p.faltaDetalle) && (
            <p class="trofeo__detalle">
              {detalle(p)}
              {p.faltaDetalle && <Dato v={p.faltaDetalle} donde={`academy: ${p.torneo}, año y categoría`} />}
            </p>
          )}
        </li>
      ))}
    </ol>
    {sinTrofeo.length > 0 && (
      <ul role="list" class="palmares__otros">
        {sinTrofeo.map((p) => (
          <li><h3 class="palmares__otro">{p.torneo}</h3> <span>{p.resultado}</span>{p.faltaDetalle && <> <Dato v={p.faltaDetalle} donde={`academy: ${p.torneo}, año y categoría`} /></>}</li>
        ))}
      </ul>
    )}
    <p class="palmares__nota">{academy.faseOro && <>{t('es', 'academy.faseOro', { fase: academy.faseOro })} </>}{t('es', 'pie.fotos')}: Xbuyer Team Academy.</p>
  </section>

  <section class="bloque equipacion" id="equipacion" data-capitulo="amarillo" aria-labelledby="equipacion-titulo">
    <div class="equipacion__cabeza">
      <h2 id="equipacion-titulo" class="equipacion__titulo">{equipacion.nombre}</h2>
      <p class="equipacion__frase">{frase[0]}<strong>{equipacion.patrocinadorTecnico}</strong>{frase[1]}</p>
    </div>
    <ul role="list" class="equipacion__piezas">
      {piezas.map((p) => (
        <li class="pieza">
          <div class="pieza__fotos" data-lado="frente">
            <Foto hueco={p.hueco as Hueco} proporcion="1 / 1" fondo="marino" sizes="(min-width: 900px) 31vw, 82vw" class="pieza__frente" />
            {p.espalda && <Foto hueco={p.espalda as Hueco} proporcion="1 / 1" fondo="marino" sizes="(min-width: 900px) 31vw, 82vw" class="pieza__espalda" />}
          </div>
          <div class="pieza__pie">
            <h3 class="pieza__nombre">{p.nombre}</h3>
            {p.espalda && (
              <button type="button" class="pieza__vuelta" hidden data-vuelta={t('es', 'academy.equipacion.vuelta')} data-frente={t('es', 'academy.equipacion.frente')}>
                {t('es', 'academy.equipacion.vuelta')}
              </button>
            )}
          </div>
          <p class="pieza__descripcion">{p.descripcion}</p>
        </li>
      ))}
    </ul>

    <div class="extras">
      <p class="extras__incluida">{equipacion.incluida}</p>
      <div class="extras__opcional">
        <h3 class="extras__titulo">{t('es', 'academy.equipacion.opcional')}</h3>
        <ul role="list" class="extras__lista">
          {extras.map((e) => (
            <li class="extra">
              <div class="extra__imagen"><Image src={imagenExtra(e.imagen)} alt={e.alt} widths={[200, 400]} sizes="160px" loading="lazy" /></div>
              <p class="extra__nombre">{e.nombre}</p>
              <p class="extra__precio">{euros(e.precio)}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="creditos">{t('es', 'pie.fotos')}: {autores(huecosEquipacion).join(', ')}</p>
  </section>

  <section class="bloque contacto" id="contacto" data-capitulo="blanco" aria-labelledby="contacto-titulo">
    <Cupon marca="Xbuyer Team Academy" tituloId="contacto-titulo" instagram={academy.instagram} />
  </section>
</Base>

<script>
  // Dar la vuelta a una camiseta: cambia el frente por la espalda. Sin script, solo se ve el frente.
  for (const boton of document.querySelectorAll<HTMLButtonElement>('.pieza__vuelta')) {
    const fotos = boton.closest('.pieza')!.querySelector<HTMLElement>('.pieza__fotos')!;
    boton.hidden = false;
    boton.addEventListener('click', () => {
      const espalda = fotos.dataset.lado !== 'espalda';
      boton.textContent = espalda ? boton.dataset.frente! : boton.dataset.vuelta!;
      fotos.dataset.lado = espalda ? 'espalda' : 'frente';
    });
  }
</script>

<style>
  /* Portada: solo el título y el monograma */
  .portada {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 16px;
    align-items: center;
    min-height: calc(100svh - var(--cabecera));
    padding: clamp(48px, 8vh, 96px) var(--margen);
  }
  .portada__texto { grid-column: 1 / 9; display: grid; justify-items: start; gap: clamp(28px, 4vw, 48px); }
  .portada__pre { gap: 14px; }
  .portada__temporada { font-family: var(--fuente-texto); font-size: var(--step-small); font-weight: 500; text-transform: none; letter-spacing: 0; opacity: 0.85; }
  .portada__titulo {
    font-size: min(var(--step-display), 13vw);
    line-height: 0.85;
    text-transform: uppercase;
  }
  .portada__titulo span { display: block; }
  .portada__titulo span + span { color: var(--azul); }
  .portada__xb { grid-column: 10 / 13; width: 100%; color: var(--azul); }

  .quienes { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 16px; align-items: start; }
  .quienes .bloque__titulo { grid-column: 1 / 6; }
  .quienes__texto { grid-column: 6 / 13; display: grid; gap: 20px; }
  .quienes__frase { font-size: var(--step-lead); line-height: 1.4; }
  .quienes__frase--primera {
    font-family: var(--fuente-display);
    font-size: var(--step-sub);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    color: var(--azul);
  }

  /* Torneos 2027: un botón por torneo, en orden de fechas */
  .torneos__cabeza { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 48px; }
  .torneos__intro { max-width: 34ch; font-size: var(--step-lead); line-height: 1.3; }
  .torneos__lista {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 48px;
  }
  .tarjeta {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    background: var(--azul-hondo);
    text-decoration: none;
    transition: background-color 200ms ease, transform 160ms var(--ease-out);
  }
  .tarjeta:active { transform: scale(0.98); }
  .tarjeta:focus-visible { outline-offset: 4px; }
  @media (hover: hover) and (pointer: fine) {
    .tarjeta:hover { background: var(--marino); }
    .tarjeta:hover .tarjeta__flecha { translate: 4px 0; }
  }
  .tarjeta__texto { display: grid; align-content: start; gap: 6px; padding: 20px 20px 56px; }
  .tarjeta__nombre {
    font-family: var(--fuente-display);
    font-size: clamp(1.5rem, 1.1rem + 1.1vw, 2.25rem);
    font-weight: 700;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .tarjeta__edicion { display: block; color: var(--amarillo); }
  .tarjeta__fechas { margin-top: 6px; font-weight: 500; font-variant-numeric: tabular-nums; }
  .tarjeta__lugar { font-size: var(--step-small); }
  .tarjeta__flecha {
    position: absolute;
    right: 20px;
    bottom: 18px;
    width: 26px;
    height: 26px;
    fill: none;
    stroke: var(--amarillo);
    stroke-width: 2.5;
    stroke-linecap: square;
    transition: translate 200ms var(--ease-out);
  }

  /* Palmarés: titular, marcador y cada torneo con su logo y su cifra */
  .palmares__cabeza { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 16px; align-items: end; }
  .palmares__titular { grid-column: 1 / 9; text-wrap: balance; }
  .palmares__texto { grid-column: 9 / 13; padding-bottom: 0.3em; font-size: var(--step-lead); line-height: 1.3; }
  .palmares :global(.marcador) { margin-top: 48px; }
  /* Vitrina: cada trofeo flota y gira despacio sobre su peana; con «Reducir movimiento», quietos */
  .vitrina {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(56px, 6vw, 88px) clamp(16px, 3vw, 48px);
    margin-top: clamp(64px, 8vw, 112px);
  }
  .trofeo { display: grid; justify-items: center; text-align: center; }
  .trofeo__pieza {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    place-items: end center;
    width: 100%;
    height: clamp(260px, 26vw, 400px);
    perspective: 900px;
  }
  .trofeo__img {
    position: relative;
    z-index: 1;
    width: auto;
    max-width: 82%;
    height: 92%;
    max-height: 92%;
    object-fit: contain;
    object-position: bottom;
  }
  /* La sombra, una elipse plana sobre la peana */
  .trofeo__sombra {
    position: absolute;
    bottom: -6px;
    width: 58%;
    height: 14px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--marino) 70%, var(--azul));
  }
  @media (prefers-reduced-motion: no-preference) {
    .trofeo__img {
      animation: flota 6s cubic-bezier(0.37, 0, 0.63, 1) infinite;
      animation-delay: calc(var(--i) * -1.1s);
      will-change: transform;
    }
    .trofeo__sombra {
      animation: sombra 6s cubic-bezier(0.37, 0, 0.63, 1) infinite;
      animation-delay: calc(var(--i) * -1.1s);
    }
  }
  @keyframes flota {
    0%, 100% { transform: translateY(0) rotateY(-14deg); }
    50% { transform: translateY(-16px) rotateY(14deg); }
  }
  @keyframes sombra {
    0%, 100% { scale: 1; }
    50% { scale: 0.8; }
  }
  .trofeo__peana {
    display: grid;
    gap: 4px;
    width: 100%;
    padding: 22px 12px 18px;
    background: var(--azul);
  }
  .trofeo__cifra {
    font-family: var(--fuente-display);
    font-size: var(--step-head);
    font-weight: 700;
    line-height: 0.85;
    font-variant-numeric: tabular-nums;
    color: var(--amarillo);
  }
  .trofeo__resultado { font-size: var(--step-small); font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; }
  .trofeo__nombre { margin-top: 16px; font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem); text-transform: uppercase; }
  .trofeo__detalle { margin-top: 4px; font-size: var(--step-small); font-variant-numeric: tabular-nums; opacity: 0.85; }
  .palmares__otros { display: flex; flex-wrap: wrap; gap: 8px 32px; margin-top: 56px; padding-top: 24px; border-top: 2px solid color-mix(in srgb, var(--blanco) 16%, transparent); }
  .palmares__otros li { display: flex; align-items: baseline; gap: 12px; }
  .palmares__otro { font-size: var(--step-lead); text-transform: uppercase; }
  .palmares__nota { margin-top: 32px; font-size: var(--step-small); opacity: 0.85; }

  /* Nueva piel: cabecera de cartel y las tres piezas en fila */
  .equipacion__cabeza {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 16px;
    align-items: end;
  }
  .equipacion__titulo {
    grid-column: 1 / 9;
    font-size: min(var(--step-display), 15vw);
    line-height: 0.85;
    text-transform: uppercase;
  }
  .equipacion__frase {
    grid-column: 9 / 13;
    padding-bottom: 0.4em;
    font-size: var(--step-lead);
    line-height: 1.25;
  }
  .equipacion__frase strong { font-weight: 500; color: var(--tinta-2); }

  .equipacion__piezas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: clamp(40px, 6vw, 80px);
  }
  /* La del medio baja un poco: fila de cartel, no de catálogo */
  .pieza:nth-child(2) { margin-top: clamp(32px, 5vw, 72px); }
  .pieza__fotos { display: grid; }
  .pieza__fotos > :global(.foto) {
    grid-area: 1 / 1;
    transition: opacity 220ms var(--ease-out), visibility 0s linear 220ms;
  }
  .pieza__fotos > :global(.pieza__espalda),
  .pieza__fotos[data-lado='espalda'] > :global(.pieza__frente) { opacity: 0; visibility: hidden; }
  .pieza__fotos[data-lado='espalda'] > :global(.pieza__espalda) { opacity: 1; visibility: visible; transition-delay: 0s; }
  .pieza__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 14px;
  }
  .pieza__nombre { font-size: var(--step-lead); text-transform: uppercase; }
  .pieza__descripcion { margin-top: 4px; }
  .pieza__vuelta {
    min-height: 44px;
    padding: 0 4px;
    border: 0;
    background: none;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }
  .pieza__vuelta:active { transform: scale(0.97); }

  /* Lo que incluye el precio y los extras opcionales */
  .extras {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 16px;
    align-items: start;
    margin-top: clamp(56px, 7vw, 104px);
  }
  .extras__incluida { grid-column: 1 / 7; font-size: var(--step-lead); line-height: 1.35; }
  .extras__opcional { grid-column: 8 / 13; }
  .extras__titulo { font-size: var(--step-sub); text-transform: uppercase; }
