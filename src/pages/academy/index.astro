---
/**
 * Xbuyer Team Academy: la selección que compite en torneos y organiza la Xbuyer Cup. Quiénes son,
 * su palmarés (con huecos para las fotos de cada torneo) y contacto. Todo sale de contenido/textos.md.
 */
import Cabecera from '../../components/Cabecera.astro';
import Cupon from '../../components/Cupon.astro';
import Foto from '../../components/Foto.astro';
import Monograma from '../../components/Monograma.astro';
import Pendiente from '../../components/Pendiente.astro';
import { academy, cup } from '../../data/contenido';
import { t } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import { fotoDe, type Hueco } from '../../lib/fotos';
import { MOSTRAR_PENDIENTES, ocultado } from '../../lib/pendiente';
import { ruta } from '../../lib/ruta';

// Cada torneo enseña sus fotos cuando las haya; mientras, en producción, solo su nombre y resultado
const palmares = academy.palmares.map((p) => ({ ...p, foto: fotoDe(p.hueco) }));
for (const p of palmares) if (!p.foto && !MOSTRAR_PENDIENTES) ocultado(Astro.url.pathname, `academy: fotos de ${p.torneo}`, 'fotos de L8 Sport Murcia');
const conFotos = MOSTRAR_PENDIENTES || palmares.some((p) => p.foto);

const enlaces = [
  { href: '#quienes', texto: t('es', 'nav.quienes') },
  { href: '#palmares', texto: t('es', 'nav.palmares') },
  { href: '#contacto', texto: t('es', 'nav.contacto') },
];
---
<Base titulo={academy.nombre} descripcion={t('es', 'academy.frase')} colorTema="#FFED00">
  <Cabecera slot="cabecera" marca={academy.nombre} capitulo="amarillo" enlaces={enlaces} otra={{ href: ruta('/cup/'), texto: cup.nombre }} />

  <section class="portada" data-capitulo="amarillo" aria-labelledby="portada-titulo">
    <div class="portada__texto">
      <h1 id="portada-titulo" class="portada__titulo"><span>Xbuyer Team</span> <span>Academy</span></h1>
      <p class="portada__frase">{t('es', 'academy.frase')}</p>
      <a class="boton" href="#palmares">{t('es', 'academy.palmares.boton')}</a>
    </div>
    <Monograma class="portada__xb" />
  </section>

  <section class="bloque quienes" id="quienes" data-capitulo="blanco" aria-labelledby="quienes-titulo">
    <h2 id="quienes-titulo" class="bloque__titulo">{t('es', 'academy.quienes')}</h2>
    <div class="quienes__texto">
      <p class="quienes__desde">{academy.desde}</p>
      <p class="quienes__familia">{academy.noEsEscuela}</p>
      <p class="quienes__familia">{academy.filosofia}</p>
    </div>
  </section>

  <section class="bloque palmares" id="palmares" data-capitulo="marino" aria-labelledby="palmares-titulo">
    <h2 id="palmares-titulo" class="bloque__titulo">{t('es', 'academy.palmares')}</h2>
    {academy.faseOro && <p class="bloque__intro">{t('es', 'academy.faseOro', { fase: academy.faseOro })}</p>}
    <ol role="list" class:list={['palmares__lista', conFotos && 'palmares__lista--fotos']}>
      {palmares.map((p) => (
        <li class:list={['torneo', p.participacion && 'torneo--participacion']}>
          <div class="torneo__texto">
            <h3 class="torneo__nombre">{p.torneo}</h3>
            <p class="torneo__resultado">{p.resultado}</p>
          </div>
          {(p.foto || MOSTRAR_PENDIENTES) && (
            <div class="torneo__foto">
              <Foto hueco={p.hueco as Hueco} proporcion="3 / 2" fondo="azul" sizes="(min-width: 900px) 40vw, 100vw" />
              {!p.foto && <Pendiente nota={`fotos de ${p.torneo} (L8 Sport Murcia)`} />}
            </div>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section class="bloque contacto" id="contacto" data-capitulo="blanco" aria-labelledby="contacto-titulo">
    <Cupon marca="Xbuyer Team Academy" tituloId="contacto-titulo" instagram={academy.instagram} />
  </section>
</Base>

<style>
  .portada {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 16px;
    align-items: center;
    min-height: calc(100svh - var(--cabecera));
    padding: clamp(48px, 8vh, 96px) var(--margen);
  }
  .portada__texto { grid-column: 1 / 9; display: grid; justify-items: start; gap: 28px; }
  .portada__titulo {
    font-size: min(var(--step-display), 13vw);
    line-height: 0.85;
    text-transform: uppercase;
  }
  .portada__titulo span { display: block; }
  .portada__titulo span + span { color: var(--azul); }
  .portada__frase { max-width: 30ch; font-size: var(--step-lead); line-height: 1.3; }
  .portada__xb { grid-column: 10 / 13; width: 100%; color: var(--azul); }

  .quienes { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 16px; align-items: start; }
  .quienes .bloque__titulo { grid-column: 1 / 6; }
  .quienes__texto { grid-column: 6 / 13; display: grid; gap: 20px; }
  .quienes__desde {
    font-family: var(--fuente-display);
    font-size: var(--step-head);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    color: var(--azul);
  }
  .quienes__familia { font-size: var(--step-lead); line-height: 1.4; }

  .palmares__lista {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px 32px;
    margin-top: 56px;
  }
  .palmares__lista--fotos { grid-template-columns: 1fr; gap: 56px; }
  .palmares__lista--fotos .torneo { display: grid; grid-template-columns: 5fr 7fr; gap: 32px; align-items: center; }
  .torneo__nombre { font-size: var(--step-head); text-transform: uppercase; color: var(--amarillo); }
  .torneo__resultado { margin-top: 6px; font-size: var(--step-lead); font-weight: 500; }
  /* Una participación no es un título: mismo orden de lectura, menos peso */
  .torneo--participacion .torneo__nombre { color: var(--blanco); font-size: var(--step-lead); }
  .torneo--participacion .torneo__resultado { font-size: var(--step-body); font-weight: 400; }
  .torneo__foto { display: grid; gap: 12px; justify-items: start; }

  .contacto { display: grid; --fondo-seccion: var(--blanco); }
  .contacto :global(.cupon) { width: min(100%, 1120px); justify-self: center; }

  @media (max-width: 899px) {
    .portada { min-height: 0; padding-block: 56px 72px; }
    .portada__texto { grid-column: 1 / -1; }
    .portada__titulo { font-size: 17vw; }
    .portada__xb { display: none; }
    .palmares__lista { grid-template-columns: 1fr; gap: 28px; }
    .quienes .bloque__titulo, .quienes__texto { grid-column: 1 / -1; }
    .quienes__texto { margin-top: 32px; }
    .palmares__lista--fotos .torneo { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
