---
/**
 * Página de una edición de la Xbuyer Cup (src/data/cup-ediciones.ts). Arriba, la sede, las fechas y la inscripción
 * (el formulario, o «Inscripciones cerradas» con la app destacada); debajo, el patrocinador principal, qué incluye,
 * categorías y formato, la sede con quién apoya la edición, y contacto.
 */
import AppEnConstruccion from '../../components/AppEnConstruccion.astro';
import Cabecera from '../../components/Cabecera.astro';
import Campo from '../../components/Campo.astro';
import Cupon from '../../components/Cupon.astro';
import Dato from '../../components/Dato.astro';
import FormularioInscripcion from '../../components/FormularioInscripcion.astro';
import LogoCup from '../../components/LogoCup.astro';
import Patrocinador from '../../components/Patrocinador.astro';
import SiCompleto from '../../components/SiCompleto.astro';
import { academy, cup } from '../../data/contenido';
import { ediciones, type Edicion } from '../../data/cup-ediciones';
import { normativa } from '../../data/normativa';
import { principal } from '../../data/patrocinadores';
import { t } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import { menuEdiciones, rutaEdicion } from '../../lib/ediciones';
import { rango } from '../../lib/fechas';
import { formularioDe } from '../../lib/formularios';
import { completo, esPendiente } from '../../lib/pendiente';
import { ruta } from '../../lib/ruta';
import { enlaceInscripcion } from '../../lib/torneos';

export function getStaticPaths() {
  return ediciones.map((edicion) => ({ params: { edicion: edicion.slug }, props: { edicion } }));
}
interface Props { edicion: Edicion }
const { edicion: ed } = Astro.props;

const fechas = rango(ed.inicio, ed.fin);
const abierta = ed.inscripcion === 'abierta';
const inscripcion = abierta ? enlaceInscripcion(ed.formulario, t('es', 'edicion.asunto', { ciudad: ed.ciudad }), Astro.url.pathname) : null;
// Con el enlace del Google Form, el formulario se rellena en la página (bloque #inscripcion); mientras no esté, el
// botón abre un email a la organización
const formulario = abierta ? formularioDe(ed.formulario) : null;
const torneoNombre = `Xbuyer Cup ${ed.ciudad}`;
const appLista = Boolean(ed.app) && completo(cup.app.appStore) && completo(cup.app.googlePlay);
const sedes = ed.sedes.filter(completo);
const sedesPendientes = ed.sedes.filter(esPendiente);
const sedesTexto = sedes.join(' y ');
const comoLlegar = (lugar: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${lugar}, ${ed.localidad}`)}`;
const otras = ediciones.filter((e) => e.slug !== ed.slug);

const cup_ = (ancla: string) => ruta(`/cup/${ancla}`);
const enlaces = [
  { href: cup_('#torneos'), texto: t('es', 'nav.ediciones'), ...menuEdiciones(ed.slug), todos: { href: cup_('#torneos'), texto: t('es', 'nav.verTodos') } },
  { href: cup_('#anteriores'), texto: t('es', 'nav.anteriores') },
  { href: '#patrocinador', texto: t('es', 'nav.patrocinador') },
  { href: '#contacto', texto: t('es', 'nav.contacto') },
];

// Datos estructurados del torneo para los buscadores (solo lo confirmado)
const evento = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${cup.nombre} ${ed.ciudad} ${ed.inicio.slice(0, 4)}`,
  sport: 'Fútbol',
  startDate: ed.inicio,
  endDate: ed.fin,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: (sedes.length ? sedes : [ed.localidad]).map((s) => ({ '@type': 'Place', name: s, address: { '@type': 'PostalAddress', addressLocality: ed.localidad, addressCountry: 'ES' } })),
  organizer: { '@type': 'SportsOrganization', name: academy.nombre, url: Astro.site ? new URL(ruta('/academy/'), Astro.site).href : undefined },
  sponsor: principal ? { '@type': 'Organization', name: principal.nombre, url: `https://www.instagram.com/${principal.instagram}/` } : undefined,
  image: Astro.site ? new URL(ruta('/compartir/cup.png'), Astro.site).href : undefined,
};
const categoriasTexto = ed.formatos.map((f) => `${f.nombre}: ${f.categorias.filter(completo).join(', ')}`).join('. ');
---
<Base
  titulo={`${cup.nombre} ${ed.ciudad} · ${fechas}`}
  descripcion={`${cup.nombre} ${ed.ciudad}: ${fechas}, ${ed.localidad}${sedesTexto ? ` (${sedesTexto})` : ''}. ${categoriasTexto}.`}
  compartir="cup"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(evento)} />
  <Cabecera slot="cabecera" marca={cup.nombre} logo="cup" capitulo="azul" enlaces={enlaces} otra={{ href: ruta('/academy/'), texto: academy.nombre }} />

  <section class="portada" data-capitulo="azul" aria-labelledby="portada-titulo">
    <a class="portada__volver enlace" href={cup_('#torneos')}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H5M11 6l-6 6 6 6" /></svg>{t('es', 'nav.ediciones')}
    </a>
    <div class="portada__cuerpo">
      <div class="portada__texto">
        <LogoCup class="portada__logo" />
        <h1 id="portada-titulo" class="portada__titulo">
          <span class="portada__marca">{cup.nombre}</span>
          <span class="portada__ciudad">{ed.ciudad}</span>
        </h1>
        <p class="portada__fecha"><time datetime={ed.inicio}>{fechas}</time></p>
        <p class="portada__sede">{ed.localidad}{sedesTexto && <><span aria-hidden="true"> · </span>{sedesTexto}</>}</p>
        <p class="portada__cuenta" data-cuenta={ed.inicio} data-fin={ed.fin} data-uno={t('es', 'cup.faltan.uno')} data-n={t('es', 'cup.faltan.n', { n: '{n}' })} data-hoy={t('es', 'cup.hoy')}></p>
      </div>
      <div class:list={['inscripcion', !abierta && 'inscripcion--cerrada']}>
        <p class="inscripcion__estado">{abierta ? t('es', 'cup.abiertas') : t('es', 'cup.cerradas')}</p>
        {inscripcion ? (
          <a class="boton inscripcion__boton" href={formulario ? '#inscripcion' : inscripcion}>{t('es', 'edicion.inscribete')}</a>
        ) : (
          <p class="inscripcion__texto">{t('es', ed.app ? 'edicion.cerradasApp' : 'edicion.cerradasTexto')}</p>
        )}
        {!abierta && ed.app && <a class="enlace inscripcion__app" href="#app">{t('es', 'edicion.app')}</a>}
      </div>
    </div>
  </section>

  {ed.app && (
    <section class="bloque app" id="app" data-capitulo="amarillo" aria-labelledby="app-titulo">
      <h2 id="app-titulo" class="bloque__titulo">{t('es', 'edicion.app')}</h2>
      <p class="app__texto">{t('es', 'edicion.appTexto')}</p>
      {cup.app.publicada ? (
        <SiCompleto datos={[cup.app.appStore, cup.app.googlePlay]} donde={`${ed.slug}: enlaces de la app`}>
          <ul role="list" class="app__tiendas">
            <li>{completo(cup.app.appStore) ? <a class="boton" href={cup.app.appStore}>App Store</a> : <Dato v={cup.app.appStore} donde={`${ed.slug}: App Store`} />}</li>
            <li>{completo(cup.app.googlePlay) ? <a class="boton" href={cup.app.googlePlay}>Google Play</a> : <Dato v={cup.app.googlePlay} donde={`${ed.slug}: Google Play`} />}</li>
          </ul>
        </SiCompleto>
      ) : <AppEnConstruccion />}
    </section>
  )}

  <Patrocinador id="patrocinador" capitulo="blanco" compacto />

  <section class="bloque incluye" data-capitulo="amarillo" aria-labelledby="incluye-titulo">
    <h2 id="incluye-titulo" class="bloque__titulo">{t('es', 'edicion.incluye')}</h2>
    <ul role="list" class="incluye__lista">
      {cup.incluye.map((d) => <li>{d}</li>)}
    </ul>
  </section>

  <section class="bloque categorias" data-capitulo="marino" aria-labelledby="categorias-titulo">
    <h2 id="categorias-titulo" class="bloque__titulo">{t('es', 'edicion.categorias')}</h2>
    {ed.equipos && <p class="bloque__intro">{t('es', 'edicion.equipos', { n: ed.equipos })}</p>}
    <div class="categorias__formatos">
      {ed.formatos.map((f) => (
        <div class="formato">
          <h3 class="formato__nombre">{f.nombre}</h3>
          <ul role="list" class="formato__categorias">
            {f.categorias.map((c) => esPendiente(c) ? (
              <SiCompleto datos={[c]} donde={`${ed.slug}: ${c.pendiente}`}><li><Dato v={c} donde={`${ed.slug}: ${c.pendiente}`} /></li></SiCompleto>
            ) : <li>{c}</li>)}
          </ul>
        </div>
      ))}
    </div>
    <Campo class="categorias__campo" />
  </section>

  <section class="bloque normativa" id="normativa" data-capitulo="amarillo" aria-labelledby="normativa-titulo">
    <div class="normativa__cabeza">
      <h2 id="normativa-titulo" class="bloque__titulo">{t('es', 'edicion.normativa')}</h2>
      <p class="normativa__intro">{t('es', 'edicion.normativaIntro')}</p>
    </div>
    <div class="normativa__rejilla">
      <div class="regla regla--duracion">
        <h3 class="regla__titulo">{t('es', 'edicion.duracion')}</h3>
        <dl class="duracion">
          {ed.normativa.duracion.map((d) => (
            <div><dt>{d.categorias}</dt><dd>{d.partes}</dd></div>
          ))}
        </dl>
        <p class="duracion__descanso">{t('es', 'edicion.descanso')}</p>
      </div>
      {normativa.map((r) => (
        <div class="regla">
          <h3 class="regla__titulo">{r.titulo}</h3>
          {r.orden ? (
            <ol class="regla__lista regla__lista--orden">{r.puntos.map((p) => <li>{p}</li>)}</ol>
          ) : (
            <ul role="list" class="regla__lista">{r.puntos.map((p) => <li>{p}</li>)}</ul>
          )}
        </div>
      ))}
    </div>
    <a class="boton normativa__boton" href={ruta(`/normativa/${ed.normativa.pdf}`)} download>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v13M6 11l6 6 6-6M4 21h16" /></svg>{t('es', 'edicion.descargar')}
    </a>
  </section>

  <section class="bloque sede" data-capitulo="blanco" aria-labelledby="sede-titulo">
    <h2 id="sede-titulo" class="bloque__titulo">{sedes.length > 1 ? t('es', 'edicion.sedes') : t('es', 'edicion.sede')}</h2>
    <div class="sede__columnas">
      <ul role="list" class="sede__lista">
        {sedes.map((lugar) => (
          <li>
            <p class="sede__nombre">{lugar}</p>
            <p class="sede__localidad">{ed.localidad}</p>
            <a class="enlace sede__mapa" href={comoLlegar(lugar)} rel="noopener">{t('es', 'edicion.comoLlegar')}<span class="solo-lector"> a {lugar}</span></a>
          </li>
        ))}
        {sedesPendientes.map((p) => (
          <SiCompleto datos={[p]} donde={`${ed.slug}: campo`}><li><p class="sede__nombre"><Dato v={p} donde={`${ed.slug}: campo`} /></p></li></SiCompleto>
        ))}
        {sedes.length === 0 && (
          <li>
            <p class="sede__localidad">{ed.localidad}</p>
            <a class="enlace sede__mapa" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(ed.localidad)}`} rel="noopener">{t('es', 'edicion.comoLlegar')}<span class="solo-lector"> a {ed.localidad}</span></a>
          </li>
        )}
      </ul>
      {(ed.apoyo.length > 0 || ed.colaboradores.length > 0) && (
        <dl class="sede__apoyos">
          {ed.apoyo.length > 0 && <div><dt>{t('es', 'edicion.apoyo')}</dt>{ed.apoyo.map((a) => <dd>{a}</dd>)}</div>}
          {ed.colaboradores.length > 0 && <div><dt>{t('es', 'edicion.colaboradores')}</dt>{ed.colaboradores.map((a) => <dd>{a}</dd>)}</div>}
        </dl>
      )}
    </div>
    <nav class="otras" aria-labelledby="otras-titulo">
      <h2 id="otras-titulo" class="otras__titulo">{t('es', 'edicion.otras')}</h2>
      <ul role="list" class="otras__lista">
        {otras.map((o) => (
          <li><a class="otras__enlace" href={rutaEdicion(o)}><span class="otras__ciudad">{o.ciudad}</span> <span class="otras__fechas">{rango(o.inicio, o.fin)}</span></a></li>
        ))}
      </ul>
    </nav>
  </section>

  {formulario && (
    <section class="bloque formulario" id="inscripcion" data-capitulo="amarillo" aria-labelledby="formulario-titulo">
      <div class="formulario__texto">
        <h2 id="formulario-titulo" class="bloque__titulo">{t('es', 'edicion.inscribete')}</h2>
        <p class="formulario__intro">{t('es', 'inscripcion.introCup', { torneo: torneoNombre })}</p>
      </div>
      <FormularioInscripcion formulario={formulario} torneo={torneoNombre} id={`ins-${ed.slug}`} />
    </section>
  )}

  <section class="bloque contacto" id="contacto" data-capitulo="azul" aria-labelledby="contacto-titulo">
    <Cupon marca="Xbuyer Cup" tituloId="contacto-titulo" titulo={t('es', 'contacto.tituloCup')} instagram={cup.instagram} />
  </section>
</Base>

<script>
  // Cuenta atrás hasta el torneo (sin JavaScript se ven las fechas)
  const el = document.querySelector<HTMLElement>('[data-cuenta]');
  if (el) {
    const { cuenta = '', fin = '', uno = '', n = '', hoy = '' } = el.dataset;
    const dia = (iso: string) => new Date(`${iso}T00:00:00`).getTime();
    const ahora = new Date();
    const hoyMs = new Date(ahora.getFullYear(), ahora.getMonth(), ahora.getDate()).getTime();
    const faltan = Math.round((dia(cuenta) - hoyMs) / 86_400_000);
    if (faltan > 1) el.textContent = n.replace('{n}', String(faltan));
    else if (faltan === 1) el.textContent = uno;
    else if (hoyMs <= dia(fin)) el.textContent = hoy;
  }
</script>

<style>
  .portada { padding: clamp(24px, 4vh, 48px) var(--margen) clamp(56px, 8vw, 112px); }
  .portada__volver { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-weight: 500; }
  .portada__volver svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: square; }
  .portada__cuerpo {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 16px;
    align-items: end;
    margin-top: clamp(24px, 4vw, 56px);
  }
  .portada__texto { grid-column: 1 / 9; display: grid; justify-items: start; gap: 16px; }
  .portada__titulo { display: grid; gap: 12px; text-transform: uppercase; }
  .portada__marca {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: var(--step-lead);
    line-height: 1;
    color: var(--marino);
  }
  .portada__logo { width: clamp(104px, 11vw, 168px); height: auto; margin: clamp(16px, 2vw, 32px) 0 12px; color: var(--marino); }
  .portada__ciudad { font-size: min(var(--step-display), 22vh); line-height: 0.85; }
  .portada__fecha {
    font-family: var(--fuente-display);
    font-size: var(--step-head);
    font-weight: 700;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--amarillo);
  }
  .portada__sede { font-size: var(--step-lead); font-weight: 500; }
  .portada__cuenta { font-size: var(--step-body); font-weight: 500; min-height: 1.5em; }

  /* Formulario de inscripción integrado: texto a la izquierda (quieto al bajar), formulario a la derecha */
  .formulario { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 16px; align-items: start; }
  .formulario__texto { grid-column: 1 / 5; display: grid; gap: 28px; position: sticky; top: 96px; }
  .formulario__intro { font-size: var(--step-lead); line-height: 1.35; max-width: 34ch; }
  .formulario :global(.inscripcion-form) { grid-column: 6 / 13; }
  @media (max-width: 899px) {
    .formulario { row-gap: 28px; }
    .formulario__texto, .formulario :global(.inscripcion-form) { grid-column: 1 / -1; position: static; }
  }

  /* La inscripción, un recuadro aparte: abierta (botón) o cerrada (aviso y la app) */
  .inscripcion {
    grid-column: 9 / 13;
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: 28px 24px;
    background: var(--marino);
    color: var(--blanco);
    --acento: var(--amarillo);
    --sobre-acento: var(--marino);
  }
  .inscripcion__estado {
    font-family: var(--fuente-display);
    font-size: var(--step-sub);
    font-weight: 700;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--amarillo);
  }
  .inscripcion--cerrada .inscripcion__estado { color: var(--blanco); }
  .inscripcion__texto { line-height: 1.4; }
  .inscripcion__app { display: inline-flex; align-items: center; min-height: 44px; font-weight: 500; }

  .app { display: grid; justify-items: start; gap: 20px; }
  .app__texto { max-width: 40ch; font-size: var(--step-lead); line-height: 1.3; }
  .app__tiendas { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 12px; }

  .incluye__lista {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px 32px;
    margin-top: 48px;
    font-size: var(--step-lead);
    line-height: 1.3;
  }
  .incluye__lista li { position: relative; padding-left: 28px; max-width: 30ch; }
  .incluye__lista li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 12px;
    height: 12px;
    background: var(--acento);
  }

  /* Categorías, con las líneas del campo detrás */
  .categorias { position: relative; isolation: isolate; overflow: hidden; }
  .categorias > :not(.categorias__campo) { position: relative; }
  .categorias__campo {
    position: absolute;
    z-index: -1;
    right: calc(var(--margen) * -1);
    bottom: clamp(24px, 4vw, 56px);
    width: min(56%, 900px);
    color: color-mix(in srgb, var(--azul) 75%, var(--marino));
  }
  .categorias__formatos { display: grid; grid-template-columns: 1fr 1fr; gap: 48px 32px; margin-top: 56px; max-width: 900px; }
  .formato__nombre {
    font-family: var(--fuente-texto);
    font-size: var(--step-lead);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.2;
    color: var(--amarillo);
  }
  .formato__categorias { display: grid; gap: 4px; margin-top: 16px; }
  .formato__categorias li {
    font-family: var(--fuente-display);
    font-size: var(--step-sub);
    font-weight: 700;
    line-height: 1.05;
    text-transform: uppercase;
  }

  /* Protocolo y normativa: fichas del reglamento y el PDF */
  .normativa__cabeza { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 48px; }
  .normativa__intro { max-width: 36ch; font-size: var(--step-lead); line-height: 1.3; }
  .normativa__rejilla { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 48px; }
  .regla { padding: 24px 20px 28px; background: var(--blanco); }
  .regla--duracion { grid-column: span 2; background: var(--marino); color: var(--blanco); }
  .regla__titulo { font-size: clamp(1.5rem, 1.1rem + 1vw, 2.25rem); text-transform: uppercase; }
  .regla--duracion .regla__titulo { color: var(--amarillo); }
  .regla__lista { display: grid; gap: 10px; margin: 16px 0 0; padding: 0; line-height: 1.4; }
  .regla__lista li { position: relative; padding-left: 20px; }
  .regla__lista li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 8px; height: 8px; background: var(--azul); }
  .regla__lista--orden { counter-reset: paso; list-style: none; }
  .regla__lista--orden li { counter-increment: paso; padding-left: 28px; }
  .regla__lista--orden li::before {
    content: counter(paso);
    top: 0;
    width: auto;
    height: auto;
    background: none;
    font-family: var(--fuente-display);
    font-weight: 700;
    font-size: 1.15em;
    color: var(--azul);
  }
  .duracion { display: grid; gap: 18px; margin: 18px 0 0; }
  .duracion dt { font-weight: 500; }
  .duracion dd { margin: 2px 0 0; font-family: var(--fuente-display); font-size: var(--step-sub); font-weight: 700; line-height: 1; text-transform: uppercase; }
  .duracion__descanso { margin-top: 16px; }
  /* La última ficha (protocolo) ocupa la fila entera, en dos columnas */
  .regla:last-child { grid-column: 1 / -1; }
  .regla:last-child .regla__lista { grid-template-columns: 1fr 1fr; column-gap: 32px; }
  .normativa__boton { margin-top: 40px; }
  .normativa__boton svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: square; }

  .sede__columnas { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 32px; margin-top: 48px; }
  .sede__lista { display: grid; gap: 32px; align-content: start; }
  .sede__nombre {
    font-family: var(--fuente-display);
    font-size: var(--step-sub);
    font-weight: 700;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .sede__localidad { margin-top: 6px; font-size: var(--step-lead); font-weight: 500; color: var(--azul); }
  .sede__mapa { display: inline-flex; align-items: center; min-height: 44px; margin-top: 8px; }
  .sede__apoyos { display: grid; gap: 24px; margin: 0; align-content: start; }
