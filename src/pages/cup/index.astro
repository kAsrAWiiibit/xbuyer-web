---
/**
 * Xbuyer Cup: presentación corta, qué la hace diferente, las ediciones de esta temporada (cada una con su página,
 * src/data/cup-ediciones.ts), las anteriores, el patrocinador principal y contacto.
 */
import TituloChute from '../../components/TituloChute.astro';
import Cabecera from '../../components/Cabecera.astro';
import Cupon from '../../components/Cupon.astro';
import Dato from '../../components/Dato.astro';
import Foto from '../../components/Foto.astro';
import LogoCup from '../../components/LogoCup.astro';
import Patrocinador from '../../components/Patrocinador.astro';
import SiCompleto from '../../components/SiCompleto.astro';
import { academy, cup } from '../../data/contenido';
import { ediciones } from '../../data/cup-ediciones';
import { enlaceInstagram, principal } from '../../data/patrocinadores';
import Synergy from '../../components/logos/Synergy.astro';
import { t } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import { rango } from '../../lib/fechas';
import { autores, fotoDe, type Hueco } from '../../lib/fotos';
import { completo } from '../../lib/pendiente';
import { ruta } from '../../lib/ruta';
import { menuEdiciones, rutaEdicion } from '../../lib/ediciones';

const enlaces = [
  { href: '#torneos', texto: t('es', 'nav.ediciones'), ...menuEdiciones(), todos: { href: '#torneos', texto: t('es', 'nav.verTodos') } },
  { href: '#anteriores', texto: t('es', 'nav.anteriores') },
  { href: '#patrocinador', texto: t('es', 'nav.patrocinador') },
  { href: '#contacto', texto: t('es', 'nav.contacto') },
];

// Las fotos de cada edición anterior: las de su fotógrafo con «Xbuyer Cup <ciudad> <año>» como origen
const galeria = (['cup-galeria-1', 'cup-galeria-2', 'cup-galeria-3', 'cup-galeria-4'] as Hueco[]).map((h) => ({ hueco: h, foto: fotoDe(h) }));
const fotosDe = (ciudad: string, fechas: string) =>
  galeria.filter((g) => g.foto?.origen === `${cup.nombre} ${ciudad} ${fechas.match(/\d{4}$/)?.[0]}`);
---
<Base
  titulo={`${cup.nombre} · ${ediciones.map((e) => e.ciudad).join(', ').replace(/, ([^,]+)$/, ' y $1')}`}
  descripcion={`${cup.frase} ${ediciones.map((e) => `${e.ciudad}: ${rango(e.inicio, e.fin)}`).join('. ')}.`}
  compartir="cup"
  fotos={['cup-portada', ...galeria.map((g) => g.hueco)]}
>
  <Cabecera slot="cabecera" marca={cup.nombre} logo="cup" capitulo="azul" enlaces={enlaces} otra={{ href: ruta('/academy/'), texto: academy.nombre }} />

  <section class="portada" data-capitulo="azul" aria-labelledby="portada-titulo">
    <div class="portada__texto">
      <LogoCup class="portada__logo" />
      <TituloChute id="portada-titulo" class="portada__titulo" lineas={['Xbuyer', 'Cup']} />
      <p class="portada__frase">{cup.frase}</p>
      <a class="boton" href="#torneos">{t('es', 'cup.verTorneos')}</a>
      {principal && (
        <a class="portada__patrocinador" href={enlaceInstagram(principal.instagram)} rel="noopener">
          <span>{t('es', 'cup.patrocinador')}</span>
          <Synergy titulo={principal.nombre} class="portada__synergy" />
        </a>
      )}
    </div>
    <Foto hueco="cup-portada" proporcion="4 / 5" fondo="marino" prioridad class="portada__foto" sizes="(min-width: 900px) 36vw, 100vw" />
  </section>

  <section class="bloque diferente" data-capitulo="blanco" aria-labelledby="diferente-titulo">
    <h2 id="diferente-titulo" class="bloque__titulo">{t('es', 'cup.diferente')}</h2>
    <ol role="list" class="diferente__lista">
      {cup.diferente.map((d, i) => (
        <li class="razon">
          <p class="razon__numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="razon__titulo">{d.titulo}</h3>
          <p class="razon__texto">{d.texto}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="bloque ediciones" id="torneos" data-capitulo="marino" aria-labelledby="ediciones-titulo">
    <h2 id="ediciones-titulo" class="bloque__titulo">{t('es', 'cup.ediciones')}</h2>
    <ol role="list" class="ediciones__lista">
      {ediciones.map((e) => (
        <li>
          <a class:list={['edicion', `edicion--${e.inscripcion}`]} href={rutaEdicion(e)}>
            <span class="edicion__estado">{e.inscripcion === 'abierta' ? t('es', 'cup.abiertas') : t('es', 'cup.cerradas')}</span>
            <span class="edicion__ciudad">{e.ciudad}</span>
            <span class="edicion__fechas"><time datetime={e.inicio}>{rango(e.inicio, e.fin)}</time></span>
            <span class="edicion__lugar">{[e.localidad, ...e.sedes.filter(completo)].join(' · ')}</span>
            <span class="edicion__ver">{t('es', 'cup.verEdicion')}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="bloque anteriores" id="anteriores" data-capitulo="blanco" aria-labelledby="anteriores-titulo">
    <h2 id="anteriores-titulo" class="bloque__titulo">{t('es', 'cup.anteriores')}</h2>
    <SiCompleto datos={[cup.cifras]} donde="cup: cifras de ediciones anteriores">
      <p class="bloque__intro"><Dato v={cup.cifras} donde="cup: cifras de ediciones anteriores" /></p>
    </SiCompleto>
    <ul role="list" class="anteriores__lista">
      {cup.anteriores.map((a) => {
        const fotos = fotosDe(a.ciudad, a.fechas);
        return (
          <li class:list={['anterior', fotos.length > 0 && 'anterior--fotos']}>
            <div>
              <h3 class="anterior__ciudad">{a.ciudad}<span class="solo-lector">, {a.fechas.toLowerCase()}</span></h3>
              {a.lugar && <p class="anterior__lugar">{a.lugar}</p>}
              <p class="anterior__fechas">{a.fechas}</p>
              {a.detalle && <p class="anterior__detalle">{a.detalle}</p>}
            </div>
            {fotos.length > 0 && (
              <div>
                <div class="anterior__fotos">
                  {fotos.map((g) => <Foto hueco={g.hueco} proporcion="3 / 2" fondo="azul" sizes="(min-width: 900px) 30vw, 100vw" />)}
                </div>
                <p class="creditos">{t('es', 'pie.fotos')}: {autores(fotos.map((g) => g.hueco)).join(', ')}</p>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  </section>

  <Patrocinador id="patrocinador" capitulo="amarillo" />

  <section class="bloque contacto" id="contacto" data-capitulo="azul" aria-labelledby="contacto-titulo">
    <Cupon marca="Xbuyer Cup" tituloId="contacto-titulo" titulo={t('es', 'contacto.tituloCup')} instagram={cup.instagram} />
  </section>
</Base>

<style>
  .portada {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 16px;
    align-items: center;
    min-height: calc(100svh - var(--cabecera));
    padding: clamp(40px, 6vh, 80px) var(--margen);
  }
  .portada__texto { grid-column: 1 / 8; display: grid; justify-items: start; gap: 24px; }
  .portada__logo { width: clamp(88px, 8vw, 128px); height: auto; color: var(--marino); }
  .portada__titulo {
    font-size: min(var(--step-display), 26vh);
    line-height: 0.85;
    text-transform: uppercase;
  }
  .portada__titulo :global(.linea + .linea) { color: var(--marino); }
  .portada__frase { max-width: 34ch; font-size: var(--step-lead); line-height: 1.3; }
  .portada__patrocinador {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    margin-top: 8px;
    font-size: var(--step-small);
    font-weight: 500;
    text-decoration: none;
  }
  .portada__synergy { width: 92px; height: auto; color: var(--blanco); }
  .portada__foto { grid-column: 8 / 13; }
  /* El trofeo y las caras, lejos del corte diagonal */
  .portada__foto :global(img) { object-position: 42% 40%; }

  /* Qué la hace diferente: cinco razones numeradas */
  .diferente__lista {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 48px 32px;
    margin-top: 56px;
  }
  .razon { grid-column: span 2; display: grid; align-content: start; gap: 10px; }
  /* Las dos últimas, más anchas: cierran la fila sin hueco */
  .razon:nth-child(4), .razon:nth-child(5) { grid-column: span 3; }
  .razon__numero {
    font-family: var(--fuente-display);
    font-size: var(--step-sub);
    font-weight: 700;
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
    color: var(--azul);
  }
  .razon__titulo { font-size: clamp(1.75rem, 1.2rem + 1.4vw, 2.75rem); text-transform: uppercase; }
  .razon__texto { max-width: 36ch; font-size: var(--step-body); line-height: 1.45; }

  /* Ediciones: una tarjeta por edición, que lleva a su página */
  .ediciones__lista { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 48px; }
  .edicion {
    display: grid;
    align-content: start;
    gap: 8px;
    height: 100%;
    padding: 28px 24px 24px;
    background: var(--azul);
    color: var(--blanco);
    text-decoration: none;
    transition: background-color 200ms ease, transform 160ms var(--ease-out);
  }
  .edicion:active { transform: scale(0.98); }
  .edicion:focus-visible { outline-offset: 4px; }
  @media (hover: hover) and (pointer: fine) {
    .edicion:hover { background: var(--azul-hondo); }
    .edicion:hover .edicion__ver svg { translate: 4px 0; }
  }
  .edicion__estado {
    justify-self: start;
    padding: 6px 10px;
    background: var(--amarillo);
    color: var(--marino);
    font-size: var(--step-small);
    font-weight: 500;
    line-height: 1.2;
  }
  .edicion--cerrada .edicion__estado { background: var(--marino); color: var(--blanco); }
  .edicion__ciudad {
    margin-top: 20px;
    font-family: var(--fuente-display);
    font-size: clamp(3rem, 1.6rem + 3.6vw, 5.5rem);
    font-weight: 700;
    line-height: 0.85;
    text-transform: uppercase;
  }
  .edicion__fechas { margin-top: 8px; font-size: var(--step-lead); font-weight: 500; color: var(--amarillo); }
  .edicion__lugar { font-size: var(--step-body); }
  .edicion__ver { display: inline-flex; align-items: center; gap: 8px; margin-top: 24px; font-weight: 500; }
  .edicion__ver svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: square; transition: translate 200ms var(--ease-out); }

  /* Ediciones anteriores */
  .anteriores__lista { display: grid; gap: 48px; margin-top: 40px; }
  .anterior__ciudad { font-size: var(--step-sub); text-transform: uppercase; }
  .anterior__lugar { margin-top: 4px; font-size: var(--step-lead); font-weight: 500; }
  .anterior__fechas { margin-top: 8px; font-size: var(--step-lead); font-weight: 500; color: var(--azul); }
  .anterior__detalle { margin-top: 4px; font-size: var(--step-lead); }
  .anterior--fotos { display: grid; gap: 24px; }
  .anterior__fotos { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

  .contacto { display: grid; padding-block: clamp(48px, 7vw, 112px); }
  .contacto :global(.cupon) { width: min(100%, 1120px); justify-self: center; }

  @media (max-width: 1099px) {
    .ediciones__lista { grid-template-columns: 1fr 1fr; }
    .diferente__lista { grid-template-columns: 1fr 1fr; }
    .razon, .razon:nth-child(4), .razon:nth-child(5) { grid-column: auto; }
  }
  @media (max-width: 899px) {
    .portada { min-height: 0; padding-block: 48px 64px; row-gap: 40px; }
    .portada__texto, .portada__foto { grid-column: 1 / -1; }
    .portada__titulo { font-size: 24vw; }
  }
  /* Tableta: la foto de portada apaisada, para no ocupar dos pantallas */
  @media (min-width: 600px) and (max-width: 899px) {
    .portada__foto { aspect-ratio: 3 / 2; }
    .portada__foto :global(img) { object-position: 50% 22%; }
  }
  @media (max-width: 599px) {
    .diferente__lista, .ediciones__lista, .anterior__fotos { grid-template-columns: 1fr; }
    .diferente__lista { gap: 36px; margin-top: 40px; }
  }
</style>
