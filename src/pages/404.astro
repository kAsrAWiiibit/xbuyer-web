---
/** Página no encontrada (GitHub Pages sirve 404.html): la marca, el campo y los dos caminos */
import Cabecera from '../components/Cabecera.astro';
import Campo from '../components/Campo.astro';
import { academy, cup } from '../data/contenido';
import { t } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import { ruta } from '../lib/ruta';
---
<Base titulo={`${t('es', 'error.titulo')} · ${academy.nombre}`} descripcion={t('es', 'error.texto')} colorTema="#0C0433" indexar={false}>
  <Cabecera slot="cabecera" marca={academy.nombre} capitulo="marino" otra={{ href: ruta('/cup/'), texto: cup.nombre }} />
  <section class="error" data-capitulo="marino" aria-labelledby="error-titulo">
    <div class="error__texto">
      <h1 id="error-titulo" class="error__titulo">{t('es', 'error.titulo')}</h1>
      <p class="error__frase">{t('es', 'error.texto')}</p>
      <ul role="list" class="error__caminos">
        <li><a class="boton" href={ruta('/')}>{t('es', 'error.inicio')}</a></li>
        <li><a class="enlace" href={ruta('/academy/')}>{academy.nombre}</a></li>
        <li><a class="enlace" href={ruta('/cup/')}>{cup.nombre}</a></li>
      </ul>
    </div>
    <Campo class="error__campo" />
  </section>
</Base>

<style>
  .error {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    min-height: calc(100svh - var(--cabecera));
    padding: clamp(48px, 8vh, 96px) var(--margen);
  }
  .error__texto { position: relative; display: grid; justify-items: start; gap: 20px; }
  .error__titulo { font-size: min(var(--step-display), 17vw); line-height: 0.85; text-transform: uppercase; }
  .error__frase { font-size: var(--step-lead); line-height: 1.3; max-width: 30ch; }
  .error__caminos { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 12px; }
  .error__caminos .enlace { display: inline-block; padding-block: 10px; }
  .error__campo {
    position: absolute;
    z-index: -1;
    right: -12%;
    bottom: -18%;
    width: min(80%, 1100px);
    color: color-mix(in srgb, var(--azul) 70%, var(--marino));
  }
  @media (max-width: 899px) {
    .error__campo { width: 160%; right: -80%; bottom: -10%; }
  }
</style>
